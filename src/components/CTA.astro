---
import Button from "./Button.astro";
---

<section
  aria-labelledby="cta-heading"
  class="relative w-full bg-transparent px-5 pb-16 pt-8 sm:px-8 md:pb-20">
  <div class="relative mx-auto max-w-7xl overflow-hidden border border-brand-accent/10 bg-white p-8 shadow-xs sm:p-12 md:p-14">
    {/* Top Brand Accent Bar */}
    <div
      class="absolute left-0 top-0 h-1.5 w-full bg-brand-secondary"
      aria-hidden="true">
    </div>

    <div class="flex flex-col items-start gap-8 md:flex-row md:items-center md:justify-between">
      <div class="max-w-xl">
        <span class="font-sans text-[11px] font-semibold uppercase tracking-wider text-brand-secondary"> Next Steps </span>
        <h2
          id="cta-heading"
          class="mt-2 font-serif text-3xl font-bold leading-tight tracking-tight text-brand-accent sm:text-4xl">
          Ready to take the next step?
        </h2>
        <p class="mt-3 font-sans text-base leading-relaxed text-brand-accent/75">
          Whether you are building a team or searching for your next career move, one conversation is all it takes to explore the possibilities.
        </p>
      </div>

      <div class="flex w-full flex-col gap-3 shrink-0 sm:w-auto sm:flex-row md:flex-col lg:flex-row">
        <Button
          href="/contact"
          variant="primary"
          size="lg">
          Looking to Hire?
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M14 5l7 7m0 0l-7 7m7-7H3"
            ></path>
          </svg>
        </Button>
        <Button
          href="/careers"
          variant="outline"
          size="lg">
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          Looking for a job?
        </Button>
      </div>
    </div>
  </div>
</section>
