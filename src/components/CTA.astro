---
import Button from './Button.astro';

interface Props {
  title?: string;
  intro?: string;
}

const {
  title = 'Tell us what you need to hire.',
  intro = 'One conversation is usually enough for us to tell you whether we can help, what the market looks like, and what it will realistically take to fill the role.',
} = Astro.props;
---

<section
  aria-labelledby="cta-heading"
  class="beacon-sweep relative w-full overflow-hidden bg-brand-accent px-5 py-16 text-white sm:px-8 md:py-20"
>
  <img
    src="https://cdn.magicpatterns.com/patterns/generated-images/f2b14831-d44e-4040-a984-08ce782d5f22.jpg"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover opacity-20"
    loading="lazy"
    decoding="async"
  />
  <div aria-hidden="true" class="absolute inset-0 bg-brand-accent/70"></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-40 left-1/2 h-130 w-130 -translate-x-1/2 rounded-full border border-brand-primary/15"
  ></div>
  <div class="relative mx-auto flex max-w-7xl flex-col items-start gap-8 md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl">
      <h2
        id="cta-heading"
        class="mt-5 font-serif text-3xl font-bold leading-tight tracking-tight sm:text-4xl"
      >
        {title}
      </h2>
      <p class="mt-4 font-sans text-base leading-relaxed text-white/70">{intro}</p>
    </div>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row md:flex-col lg:flex-row">
      <Button href="/contact" variant="primary" size="lg">
        Start a Search
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </Button>
      <Button href="/careers" variant="outlineLight" size="lg">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Browse Open Roles
      </Button>
    </div>
  </div>
</section>