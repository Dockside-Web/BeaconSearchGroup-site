---
import { Image } from "astro:assets";
import { contactInfo, socialLinks } from "../data/site.ts";
import logo from "../assets/logo/logo-left.png";

interface Props {
  services?: Array<{ name: string; slug: string }>;
}

const {
  services = [
    { name: "Direct Hire Search", slug: "direct-hire" },
    { name: "Executive Search", slug: "executive-search" },
    { name: "Contract & Staffing", slug: "contract-staffing" },
    { name: "RPO & Volume Hiring", slug: "rpo-volume" }
  ]
} = Astro.props;

const year = new Date().getFullYear();

const companyLinks = [
  { label: "Home", to: "/" },
  { label: "Leadership Team", to: "/leadership" },
  { label: "Careers & Open Roles", to: "/careers" },
  { label: "Contact Us", to: "/contact" }
];

// Helper to generate a dynamic Google Maps search URL from address lines
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contactInfo.addressLines.join(", "))}`;
---

<footer class="w-full bg-brand-accent px-5 pb-8 pt-16 text-white sm:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 border-b border-white/10 pb-12 md:grid-cols-2 lg:grid-cols-4">
      {/* Brand Column */}
      <div class="lg:pr-6">
        <div class="flex items-center gap-3">
          <Image src={logo} alt="Beacon Search Group Logo" class="h-10 w-auto" />
        </div>
        <p class="mt-5 font-serif text-lg italic leading-relaxed text-brand-primary">
          Lighting the Way In Talent Innovation
        </p>
        <p class="mt-4 font-sans text-sm leading-relaxed text-white/60">
          Specialized recruiting and executive search for manufacturing, engineering, and industrial
          operations. We work with companies of any size or hiring volume.
        </p>
      </div>

      {/* Services Nav */}
      <nav aria-labelledby="footer-services">
        <h2
          id="footer-services"
          class="font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-white/45">
          Services
        </h2>
        <ul class="mt-5 space-y-3">
          {
            services.map(service => (
              <li>
                <a
                  href={`/services#${service.slug}`}
                  class="font-sans text-sm text-white/80 transition-colors hover:text-brand-primary">
                  {service.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Company Nav */}
      <nav aria-labelledby="footer-company">
        <h2
          id="footer-company"
          class="font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-white/45">
          Company
        </h2>
        <ul class="mt-5 space-y-3">
          {
            companyLinks.map(item => (
              <li>
                <a
                  href={item.to}
                  class="font-sans text-sm text-white/80 transition-colors hover:text-brand-primary">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Get in Touch */}
      <div>
        <h2 class="font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-white/45">
          Get in Touch
        </h2>
        <ul class="mt-5 space-y-3.5 font-sans text-sm text-white/80">
          {/* Phone */}
          <li>
            <a
              href={contactInfo.phoneHref}
              class="inline-flex items-start gap-3 transition-colors hover:text-brand-primary">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-brand-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
              {contactInfo.phone}
            </a>
          </li>

          {/* Email */}
          <li>
            <a
              href={`mailto:${contactInfo.email}`}
              class="inline-flex items-start gap-3 break-all transition-colors hover:text-brand-primary">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-brand-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              {contactInfo.email}
            </a>
          </li>

          {/* Clickable Address (Google Maps) */}
          <li>
            <a
              href={mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group/address flex items-start gap-3 transition-colors hover:text-brand-primary">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-brand-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <address class="not-italic leading-relaxed">
                {contactInfo.addressLines.map(line => <span class="block">{line}</span>)}
              </address>
            </a>
          </li>

          <li class="pt-1">
            <div class="flex items-center gap-2">
              <a
                href={socialLinks.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Follow us on LinkedIn"
                class="inline-flex h-7 w-7 items-center justify-center rounded-sm bg-white/10 text-brand-primary transition-colors hover:bg-brand-primary hover:text-brand-accent">
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"
                  ></path>
                </svg>
              </a>

              <a
                href={socialLinks.facebook}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Follow us on Facebook"
                class="inline-flex h-7 w-7 items-center justify-center rounded-sm bg-white/10 text-brand-primary transition-colors hover:bg-brand-primary hover:text-brand-accent">
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H7.5v-3H10V9.69c0-2.47 1.47-3.83 3.72-3.83 1.08 0 2.21.19 2.21.19v2.43h-1.25c-1.22 0-1.6.76-1.6 1.54V12h2.73l-.44 3h-2.29v6.8c4.56-.93 8-4.96 8-9.8z"
                  ></path>
                </svg>
              </a>

              <a
                href={socialLinks.instagram}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Follow us on Instagram"
                class="inline-flex h-7 w-7 items-center justify-center rounded-sm bg-white/10 text-brand-primary transition-colors hover:bg-brand-primary hover:text-brand-accent">
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                  ></path>
                </svg>
              </a>
            </div>
          </li>
        </ul>
      </div>
    </div>

    {/* Sub-footer */}
    <div class="flex flex-col gap-3 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-sans text-xs text-white/45">
        © {year} Beacon Search Group. All rights reserved.
      </p>
      <p class="font-sans text-xs text-white/45">
        <a href="/legal/privacy-policy/" class="transition-colors hover:text-brand-primary"
          >Privacy Policy</a
        >
        <span class="mx-2 text-white/25">|</span>
        <a href="/legal/terms-of-service/" class="transition-colors hover:text-brand-primary"
          >Terms of Service</a
        >
      </p>
    </div>
  </div>
</footer>
