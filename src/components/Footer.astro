---
import { Image } from "astro:assets";
import { contactInfo } from '../data/site.ts'
import logo from '../assets/logo/logo-icon-only.png';

interface Props {
  services?: Array<{ name: string; slug: string }>;
  contactInfo?: {
    phone: string;
    phoneHref: string;
    email: string;
    addressLines: string[];
  };
}

const {
  services = [
    { name: 'Direct Hire Search', slug: 'direct-hire' },
    { name: 'Executive Search', slug: 'executive-search' },
    { name: 'Contract & Staffing', slug: 'contract-staffing' },
    { name: 'RPO & Volume Hiring', slug: 'rpo-volume' },
  ],
} = Astro.props;

const year = new Date().getFullYear();

const companyLinks = [
  { label: 'Home', to: '/' },
  { label: 'Leadership Team', to: '/leadership' },
  { label: 'Careers & Open Roles', to: '/careers' },
  { label: 'Contact Us', to: '/contact' },
];
---

<footer class="w-full bg-brand-accent px-5 pb-8 pt-16 text-white sm:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 border-b border-white/10 pb-12 md:grid-cols-2 lg:grid-cols-4">
      {/* Brand Column */}
      <div class="lg:pr-6">
        <div class="flex items-center gap-3">
          <!-- BeaconMark SVG -->
          <Image src={logo} alt="Logo" class="h-10 w-auto" />
      <span
        class="font-['Montserrat',sans-serif] text-lg font-extrabold uppercase tracking-[-0.02em] text-brand-secondary"
      >
        Beacon Search Group
      </span>
        </div>
        <p class="mt-5 font-serif text-lg italic leading-relaxed text-brand-primary">
          Lighting the Way In Talent Innovation
        </p>
        <p class="mt-4 font-sans text-sm leading-relaxed text-white/60">
          Specialized recruiting and executive search for manufacturing, engineering,
          and industrial operations. We work with companies of any size or hiring volume.
        </p>
      </div>

      {/* Services Nav */}
      <nav aria-labelledby="footer-services">
        <h2
          id="footer-services"
          class="font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-white/45"
        >
          Services
        </h2>
        <ul class="mt-5 space-y-3">
          {services.map((service) => (
            <li>
              <a
                href={`/services#${service.slug}`}
                class="font-sans text-sm text-white/80 transition-colors hover:text-brand-primary"
              >
                {service.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {/* Company Nav */}
      <nav aria-labelledby="footer-company">
        <h2
          id="footer-company"
          class="font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-white/45"
        >
          Company
        </h2>
        <ul class="mt-5 space-y-3">
          {companyLinks.map((item) => (
            <li>
              <a
                href={item.to}
                class="font-sans text-sm text-white/80 transition-colors hover:text-brand-primary"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {/* Get in Touch */}
      <div>
        <h2 class="font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-white/45">
          Get in Touch
        </h2>
        <ul class="mt-5 space-y-4 font-sans text-sm text-white/80">
          <li>
            <a
              href={contactInfo.phoneHref}
              class="inline-flex items-start gap-3 transition-colors hover:text-brand-primary"
            >
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              {contactInfo.phone}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${contactInfo.email}`}
              class="inline-flex items-start gap-3 break-all transition-colors hover:text-brand-primary"
            >
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              {contactInfo.email}
            </a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <address class="not-italic leading-relaxed">
              {contactInfo.addressLines.map((line) => (
                <span class="block">{line}</span>
              ))}
            </address>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 transition-colors hover:text-brand-primary"
            >
              <svg class="h-4 w-4 shrink-0 text-brand-primary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"></path>
              </svg>
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Sub-footer */}
    <div class="flex flex-col gap-3 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-sans text-xs text-white/45">
        © {year} Beacon Search Group. All rights reserved.
      </p>
      <p class="font-sans text-xs text-white/45">
        Equal opportunity employer and recruiting partner.
      </p>
    </div>
  </div>
</footer>