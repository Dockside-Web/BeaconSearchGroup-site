---
// Header.astro
import Button from './Button.astro'
import { contactInfo } from '../data/site.ts'
import { Image } from "astro:assets";
import logo from '../assets/logo/logo-icon-only.png';

const navItems = [
  { label: 'Services', href: '/services' },
  { label: 'Leadership', href: '/leadership' },
  { label: 'Careers', href: '/careers' },
  { label: 'Contact', href: '/contact' },
]

const currentPath = Astro.url.pathname

function isActive(href: string) {
  if (href === '/') return currentPath === '/'
  return currentPath === href || currentPath.startsWith(`${href}/`)
}
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full border-b border-brand-accent/10 bg-white/95 backdrop-blur"
>
  <!-- Top utility bar -->
  <div class="hidden w-full bg-brand-accent md:block">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-8 py-2">
      <p class="font-serif text-[13px] italic text-white/70">
        Lighting the Way In Talent Innovation
      </p>
      <a
        href={contactInfo.phoneHref}
        class="inline-flex items-center gap-2 font-sans text-[13px] font-medium text-white/80 transition-colors hover:text-brand-primary"
      >
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
          ></path>
        </svg>
        {contactInfo.phone}
      </a>
    </div>
  </div>

  <!-- Main row -->
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a href="/" class="flex items-center gap-3" aria-label="Home">
      <Image src={logo} alt="Logo" class="h-10 w-auto" />
      <span
        class="font-['Montserrat',sans-serif] text-lg font-extrabold uppercase tracking-[-0.02em] text-brand-secondary"
      >
        Beacon Search Group
      </span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-5 md:flex lg:gap-8">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class={`relative font-sans text-sm font-medium transition-colors after:absolute after:-bottom-1.5 after:left-0 after:h-0.5 after:bg-brand-secondary after:transition-all lg:text-[15px] ${
              isActive(item.href)
                ? 'text-brand-accent after:w-full'
                : 'text-brand-accent/70 hover:text-brand-accent after:w-0 hover:after:w-full'
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 md:flex lg:gap-3">
      <Button href="/careers" variant="outline" class="whitespace-nowrap px-4 text-sm lg:px-5 lg:text-[15px]">
        Find a Role
      </Button>
      <Button href="/contact" variant="primary" class="whitespace-nowrap px-4 text-sm lg:px-5 lg:text-[15px]">
        Contact Us
      </Button>
    </div>

    <button
      type="button"
      id="mobile-nav-toggle"
      class="inline-flex h-11 w-11 items-center justify-center rounded-sm border border-brand-accent/15 text-brand-accent md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <!-- Menu icon -->
      <svg
        id="icon-menu"
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
      <!-- Close icon (hidden by default) -->
      <svg
        id="icon-close"
        class="hidden h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile nav panel -->
  <div id="mobile-nav" class="hidden border-t border-brand-accent/10 bg-white md:hidden">
    <nav aria-label="Mobile" class="mx-auto max-w-7xl px-5 py-4 sm:px-8">
      <ul class="flex flex-col">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="block border-b border-brand-accent/10 py-3.5 font-serif text-lg font-bold text-brand-accent"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-5 flex flex-col gap-3">
        <Button href="/contact" variant="primary" size="lg" class="w-full">
          Start a Search
        </Button>
        <Button href="/careers" variant="outline" size="lg" class="w-full">
          Find a Role
        </Button>
        <a
          href={contactInfo.phoneHref}
          class="mt-1 inline-flex items-center justify-center gap-2 font-sans text-sm text-brand-accent/70"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
            ></path>
          </svg>
          {contactInfo.phone}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle — plain JS, no framework runtime needed.
  const toggleBtn = document.getElementById('mobile-nav-toggle')
  const mobileNav = document.getElementById('mobile-nav')
  const iconMenu = document.getElementById('icon-menu')
  const iconClose = document.getElementById('icon-close')

  function setOpen(open: boolean) {
    if (!toggleBtn || !mobileNav || !iconMenu || !iconClose) return
    toggleBtn.setAttribute('aria-expanded', String(open))
    toggleBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
    mobileNav.classList.toggle('hidden', !open)
    iconMenu.classList.toggle('hidden', open)
    iconClose.classList.toggle('hidden', !open)
  }

  toggleBtn?.addEventListener('click', () => {
    const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true'
    setOpen(!isOpen)
  })

  // Close the mobile menu on client-side navigation (Astro view transitions)
  // and on plain full-page loads alike.
  document.addEventListener('astro:page-load', () => setOpen(false))
</script>