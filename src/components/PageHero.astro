---
// src/components/shared/PageHero.astro
//
// Converted from the React PageHero (framer-motion swapped for a plain CSS
// fade-up animation on load, since there's no client-side runtime here).
//
// The Eyebrow markup is inlined below rather than imported, since the
// original pulled it from ../ui/Section. If you already have an
// Eyebrow.astro equivalent, swap the <p> block for <Eyebrow tone="dark">.

interface Props {
  eyebrow: string
  title: string
  intro: string
  image?: string
  imageAlt?: string
}

const { eyebrow, title, intro, image, imageAlt = '' } = Astro.props
---

<section class="beacon-sweep relative w-full overflow-hidden bg-brand-accent px-5 py-16 text-white sm:px-8 md:py-24">
  {
    image && (
      <>
        <img
          src={image}
          alt={imageAlt}
          class="absolute inset-0 h-full w-full object-cover opacity-30"
          loading="eager"
          decoding="async"
        />
        <div aria-hidden="true" class="absolute inset-0 bg-brand-accent/70" />
        <div
          aria-hidden="true"
          class="absolute inset-y-0 left-0 hidden w-1/2 bg-brand-accent/50 md:block"
        />
      </>
    )
  }

  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-24 -top-32 h-[420px] w-[420px] rounded-full border border-white/[0.06]"
  />
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-10 -top-16 h-[280px] w-[280px] rounded-full border border-brand-primary/20"
  />

  <div class="page-hero-content relative mx-auto w-full max-w-6xl">
    <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-secondary">
      {eyebrow}
    </p>
    <h1 class="mt-5 max-w-3xl font-serif text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl md:text-[56px]">
      {title}
    </h1>
    <p class="mt-6 max-w-2xl font-sans text-lg leading-relaxed text-white/70">
      {intro}
    </p>
    <div class="mt-9">
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero-content {
    animation: page-hero-fade-up 0.5s ease-out both;
  }

  @keyframes page-hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero-content {
      animation: none;
    }
  }
</style>