---
import { Image } from "astro:assets";
import logoIcon from "../assets/logo/logo-icon-only.png";

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section
  class="relative overflow-hidden bg-gradient-to-br from-[#1e3850] via-[#1a3146] to-[#142638] py-16 md:py-24 text-white">
  {/* Atmospheric Background Glows */}
  <div
    class="pointer-events-none absolute -left-32 -top-32 h-96 w-96 rounded-full bg-[#50abe4]/20 blur-[120px]"
    aria-hidden="true">
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
      {/* LEFT: Text Content */}
      <div class="relative z-10 lg:col-span-7 max-w-3xl">
        {
          eyebrow && (
            <div class="mb-4">
              <span class="font-mono text-xs font-bold uppercase tracking-[0.25em] text-[#f59242]">
                {eyebrow}
              </span>
            </div>
          )
        }

        <h1
          class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl leading-[1.08]">
          {title}
        </h1>

        {
          intro && (
            <p class="mt-6 text-lg leading-relaxed text-[#b5cbde] sm:text-xl font-normal">
              {intro}
            </p>
          )
        }

        {
          Astro.slots.has("default") && (
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <slot />
            </div>
          )
        }
      </div>

      {/* RIGHT: Logo Watermark with Localized Beacon Glow */}
      <div
        class="pointer-events-none relative flex justify-end lg:col-span-5 h-full min-h-[16rem] lg:min-h-0">
        {/* Localized amber/blue ambient glow anchored right behind the logo */}
        <div
          class="absolute right-4 top-1/2 -translate-y-1/2 h-72 w-72 rounded-full bg-gradient-to-tr from-[#50abe4]/20 via-[#f59242]/20 to-transparent blur-[90px]"
          aria-hidden="true">
        </div>

        <Image
          src={logoIcon}
          alt=""
          aria-hidden="true"
          class="absolute right-[-10%] top-1/2 -translate-y-1/2 h-[120%] w-auto max-w-none object-contain opacity-[0.12] mix-blend-screen grayscale brightness-125 lg:right-0 lg:h-[135%]"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
