---
import { Image } from "astro:assets";
import logoIcon from "../assets/logo/logo-icon-only.png";

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section
  class="relative overflow-hidden bg-linear-to-br from-[#1e3850] via-[#1a3146] to-[#142638] py-16 md:py-24 text-white">
  {/* Atmospheric Background Glow - Left */}
  <div
    class="pointer-events-none absolute -left-32 -top-32 h-96 w-96 rounded-full bg-brand-primary/20 blur-[120px]"
    aria-hidden="true">
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
      {/* LEFT: Text Content */}
      <div class="relative z-10 lg:col-span-7 max-w-3xl">
        {
          eyebrow && (
            <div class="mb-4">
              <span class="font-mono text-xs font-bold uppercase tracking-[0.25em] text-brand-secondary">
                {eyebrow}
              </span>
            </div>
          )
        }

        <h1
          class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl leading-[1.08]">
          {title}
        </h1>

        {
          intro && (
            <p class="mt-6 text-lg leading-relaxed text-[#b5cbde] sm:text-xl font-normal">
              {intro}
            </p>
          )
        }

        {
          Astro.slots.has("default") && (
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <slot />
            </div>
          )
        }
      </div>

      {
        /* RIGHT: Logo Watermark (Sits absolute behind content on narrow screens, relative on desktop) */
      }
      <div
        class="pointer-events-none absolute inset-y-0 right-0 z-0 flex items-center justify-end pr-4 sm:pr-8 lg:relative lg:inset-auto lg:col-span-5 lg:p-0">
        {/* Atmospheric Background Glow - Right */}
        <div
          class="absolute right-0 top-1/2 -translate-y-1/2 h-80 w-80 rounded-full bg-brand-primary/20 blur-[120px]"
          aria-hidden="true">
        </div>

        <Image
          src={logoIcon}
          alt=""
          aria-hidden="true"
          class="relative z-10 h-48 sm:h-56 lg:h-64 w-auto max-w-none object-contain opacity-[0.10] mix-blend-screen grayscale brightness-125 lg:opacity-[0.12]"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
