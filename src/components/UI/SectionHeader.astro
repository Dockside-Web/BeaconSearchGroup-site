---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  theme?: "light" | "dark";
}

const { eyebrow, title, description, align = "left", theme = "light" } = Astro.props;

const isDark = theme === "dark";
const isCenter = align === "center";
---

<div class={`${isCenter ? "mx-auto text-center" : ""} max-w-2xl`}>
  <p
    class={`flex items-center gap-3 font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-primary ${
      isCenter ? "justify-center" : ""
    }`}>
    <span aria-hidden="true" class="inline-block h-0.5 w-6 bg-brand-secondary"></span>
    {eyebrow}
  </p>
  <h2
    class={`mt-2 font-serif text-3xl font-bold tracking-tight sm:text-4xl ${
      isDark ? "text-white" : "text-brand-accent"
    }`}>
    {title}
  </h2>
  {
    description && (
      <p
        class={`mt-4 font-sans text-base leading-relaxed ${
          isDark ? "text-white/70" : "text-brand-accent/70"
        } ${isCenter ? "mx-auto" : ""}`}>
        {description}
      </p>
    )
  }
</div>
