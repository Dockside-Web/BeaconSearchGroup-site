---
interface Job {
  slug: string
  title: string
  department: string
  location: string
  summary: string
  datePosted: string
  applyUrl: string
  employmentType: string
}

interface Props {
  job: Job
}

const { job } = Astro.props

const searchIndex = `${job.title} ${job.location} ${job.department} ${job.summary}`.toLowerCase()

function formatDate(iso: string) {
  return new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  })
}
---

<li
  data-job
  data-department={job.department}
  data-search={searchIndex}
  class="group relative border border-brand-accent/10 bg-white transition-colors duration-200 hover:border-brand-primary/50"
>
  <div class="flex flex-col gap-5 sm:flex-row sm:items-stretch">
    <!-- Image section with orange border -->
    <div class="relative shrink-0 overflow-hidden sm:w-52">
      <img
        src="https://cdn.magicpatterns.com/patterns/generated-images/f52c5b3a-ec06-48ab-8167-b0088a13037b.jpg"
        alt=""
        aria-hidden="true"
        class="h-40 w-full object-cover transition-transform duration-500 group-hover:scale-105 sm:h-full"
        loading="lazy"
        decoding="async"
      />
      <span
        aria-hidden="true"
        class="absolute bottom-0 left-0 h-1 w-full bg-brand-secondary sm:h-full sm:w-1"
      />
    </div>

    <!-- Card Content -->
    <div class="flex flex-1 flex-col gap-5 p-6 pt-0 sm:flex-row sm:items-center sm:justify-between sm:p-7 sm:pl-0">
      <div class="min-w-0">
        <!-- Badges -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center rounded-sm bg-brand-primary-soft px-2.5 py-1 font-sans text-[11px] font-semibold uppercase tracking-[0.12em] text-brand-primary-dark">
            {job.department}
          </span>
          <span class="inline-flex items-center gap-1.5 font-sans text-[11px] font-semibold uppercase tracking-[0.12em] text-brand-secondary">
            <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-brand-secondary" />
            Open
          </span>
        </div>

        <!-- Job Title -->
        <h3 class="mt-3 font-serif text-xl font-bold text-brand-accent sm:text-2xl">
          <a
            href={job.applyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="after:absolute after:inset-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
          >
            {job.title}
          </a>
        </h3>

        <!-- Summary -->
        <p class="mt-2 max-w-2xl font-sans text-sm leading-relaxed text-brand-accent/65">
          {job.summary}
        </p>

        <!-- Meta details -->
        <ul class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 font-sans text-[13px] text-brand-accent/55">
          <li class="inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-brand-primary" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            {job.location}
          </li>
          <li class="inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-brand-primary" aria-hidden="true">
              <rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
            </svg>
            {job.employmentType}
          </li>
          <li class="inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-brand-primary" aria-hidden="true">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>
            </svg>
            Posted {formatDate(job.datePosted)}
          </li>
        </ul>
      </div>

      <!-- CTA Button Link -->
      <span class="inline-flex shrink-0 items-center gap-2 font-sans text-sm font-semibold text-brand-secondary sm:self-center">
        View role
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </span>
    </div>
  </div>
</li>