---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";

const pageTitle = "Page Not Found";
const metaDescription = "This page doesn't exist.";
---

<Layout title={pageTitle} description={metaDescription} noindex>
  <PageHero
    eyebrow="Error"
    title="Page Not Found"
    intro="The page you're looking for doesn't exist or has been moved.">
    <div class="flex flex-wrap gap-3">
      <Button href="/contact" variant="primary" size="lg">
        Talk to Us About Hiring
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
        </svg>
      </Button>
      <Button href="/careers" variant="outlineLight" size="lg">I'm Looking for a Role</Button>
    </div>
  </PageHero>
</Layout>
