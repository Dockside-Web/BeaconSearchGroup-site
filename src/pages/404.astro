---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";

const pageTitle = "Page Not Found";
const metaDescription = "This page doesn't exist.";
---

<Layout title={pageTitle} description={metaDescription}>
  <PageHero
    eyebrow="Error"
    title="Page Not Found"
    intro="The page you're looking for doesn't exist or has been moved.">
    <div class="flex flex-wrap gap-3">
      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-brand-primary px-6 py-3 font-sans text-sm font-semibold text-white transition hover:bg-brand-primary-dark">
        Talk to Us About Hiring
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
      <a
        href="/careers"
        class="inline-flex items-center gap-2 border border-brand-accent/25 px-6 py-3 font-sans text-sm font-semibold text-brand-accent transition hover:border-brand-accent hover:bg-brand-accent/5">
        I'm looking for a role
      </a>
    </div>
  </PageHero>
</Layout>
