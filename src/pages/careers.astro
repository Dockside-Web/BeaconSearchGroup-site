---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/UI/SectionHeader.astro";
import { contactInfo } from "../data/site";
import ClientContactForm from "../components/ClientContactForm.astro";

const pageTitle = "Careers";
const metaDescription =
  "Open searches for manufacturers, engineering firms, and industrial operations from skilled trades to leadership roles.";
---

<Layout title={pageTitle} description={metaDescription}>
  <PageHero
    eyebrow="Careers"
    title="Make Your Next Move Count"
    intro="Connecting skilled trades and executive leaders with top industrial firms nationwide."
  />

  <!-- ============ Open roles ============ -->
  <section
    id="open-roles"
    aria-labelledby="open-roles-heading"
    class="scroll-mt-32 bg-brand-primary-soft px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeader
        eyebrow="Candidate Opportunities"
        title="Current Openings"
        description="Every posting links directly to that role's application page"
      />

      <div class="mt-8 flex flex-col gap-4">
        <div class="flex flex-col gap-4 sm:flex-row">
          <div class="sm:w-64">
            <label for="job-department" class="sr-only">Department</label>
            <select
              id="job-department"
              class="w-full rounded-sm border border-brand-accent/15 bg-white px-4 py-3 font-sans text-sm text-brand-accent focus:border-brand-primary focus:outline-none focus:ring-2 focus:ring-brand-primary/25">
              <option value="All">All departments</option>
            </select>
          </div>
          <div class="relative flex-1">
            <label for="job-search" class="sr-only">Search open roles</label>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-brand-accent/40"
              aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              id="job-search"
              type="search"
              placeholder="Search by title, location, or keyword"
              class="w-full rounded-sm border border-brand-accent/15 bg-white py-3 pl-11 pr-4 font-sans text-sm text-brand-accent placeholder:text-brand-accent/40 focus:border-brand-primary focus:outline-none focus:ring-2 focus:ring-brand-primary/25"
            />
          </div>
        </div>
      </div>

      <p id="job-count" aria-live="polite" class="mt-6 font-sans text-sm text-brand-accent/60">
        Loading roles&hellip;
      </p>

      <!-- Job cards are rendered client-side into this list -->
      <ul id="job-list" class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2"></ul>

      <!-- Template for a single job card. Cloned and populated in the script below. -->
      <template id="job-card-template">
        <li
          data-job
          class="group relative flex flex-col justify-between rounded-md border border-slate-200/80 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-primary/50 hover:shadow-md">
          <div>
            <!-- Top Bar: Department & Status -->
            <div class="flex items-center justify-between gap-2">
              <span
                data-field="department"
                class="inline-flex items-center rounded-md bg-brand-primary/10 px-2.5 py-1 font-sans text-xs font-semibold uppercase tracking-wider text-brand-primary-dark">
              </span>
              <span
                class="inline-flex items-center gap-1.5 font-sans text-xs font-semibold uppercase tracking-wider text-brand-secondary-dark">
                <span aria-hidden="true" class="h-2 w-2 rounded-full bg-brand-secondary"></span>
                Open
              </span>
            </div>

            <!-- Title -->
            <h3
              class="mt-3 font-serif text-xl font-bold text-brand-accent group-hover:text-brand-primary transition-colors">
              <a
                data-field="apply-link"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="after:absolute after:inset-0 focus:outline-none">
                <span data-field="title"></span>
              </a>
            </h3>

            <!-- Single Inline Sub-Header: Prominent Location + Meta Info -->
            <div
              class="mt-2 flex flex-wrap items-center gap-x-2.5 gap-y-1 font-sans text-xs text-slate-500">
              <!-- Location -->
              <span class="inline-flex items-center gap-1 text-sm font-semibold text-brand-accent">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4 text-brand-primary shrink-0"
                  aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span data-field="location"></span>
              </span>

              <span class="text-slate-300" aria-hidden="true">&bull;</span>

              <!-- Employment Type -->
              <span data-field="employment-type"></span>

              <span class="text-slate-300" aria-hidden="true">&bull;</span>

              <!-- Date Posted -->
              <span>Posted <span data-field="date-posted"></span></span>
            </div>

            <!-- Summary -->
            <p class="mt-3 font-sans text-sm leading-relaxed text-slate-600" data-field="summary">
            </p>
          </div>

          <!-- Bottom CTA Area (Compact Footer) -->
          <div class="mt-5 flex justify-end border-t border-slate-100 pt-3.5">
            <span
              class="inline-flex items-center gap-1.5 rounded-sm bg-brand-secondary/10 px-3.5 py-1.5 font-sans text-xs font-semibold text-brand-secondary-dark group-hover:bg-brand-secondary group-hover:text-white transition-all">
              View role
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
                aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </span>
          </div>
        </li>
      </template>

      <!-- Load More Button Container -->
      <div id="load-more-container" class="mt-8 hidden justify-center">
        <button
          id="load-more-btn"
          type="button"
          class="inline-flex items-center rounded-sm bg-brand-primary px-6 py-3 font-sans text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-primary-dark focus:outline-none focus:ring-2 focus:ring-brand-primary/50 cursor-pointer">
          Load More Roles
        </button>
      </div>

      <div
        id="no-results"
        class="hidden mt-4 flex-col items-center border border-dashed border-brand-accent/20 bg-white px-6 py-16 text-center">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-8 w-8 text-brand-accent/30"
          aria-hidden="true">
          <rect x="3" y="8" width="18" height="12" rx="2"></rect><path d="M3 12h4l2 3h6l2-3h4"
          ></path><path d="M12 4v4"></path>
        </svg>
        <h3 class="mt-4 font-serif text-xl font-bold text-brand-accent">
          No roles match that search
        </h3>
        <p class="mt-2 max-w-md font-sans text-sm leading-relaxed text-brand-accent/60">
          Try a broader keyword or a different category. New roles open weekly, and many are filled
          before they are ever posted.
        </p>
        <button
          id="clear-filters"
          type="button"
          class="mt-6 inline-flex items-center rounded-sm border border-brand-accent/25 px-5 py-2.5 font-sans text-sm font-semibold text-brand-accent transition-colors hover:border-brand-primary hover:text-brand-primary-dark">
          Clear filters
        </button>
      </div>
    </div>
  </section>

  <!-- ============ Bottom CTA / candidate form ============ -->
  <section
    aria-labelledby="candidate-cta"
    class="beacon-sweep overflow-hidden bg-brand-accent px-4 py-20 text-white sm:px-6 lg:px-8">
    <div class="relative mx-auto max-w-7xl">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-16">
        <div class="max-w-xl">
          <h2 id="candidate-cta" class="mt-2 font-serif text-3xl font-bold text-white sm:text-4xl">
            Don't see your role posted?
          </h2>
          <p class="mt-4 font-sans text-base leading-relaxed text-white/70">
            Most of our roles are filled from relationships, not postings. Send us your resume and
            we will keep you in mind as roles open in your discipline and geography.
          </p>
          <p class="mt-6 font-sans text-sm leading-relaxed text-white/50">
            Prefer email? {
              contactInfo.email ? (
                <a
                  href={`mailto:${contactInfo.email}`}
                  class="underline decoration-white/30 underline-offset-2 hover:text-white/70">
                  Reach out directly
                </a>
              ) : (
                "Reach out directly"
              )
            } and a recruiter will follow up with you.
          </p>
        </div>

        <div class="rounded-sm bg-white p-6 sm:p-8">
          <ClientContactForm />
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const CSV_URL =
    "https://docs.google.com/spreadsheets/d/e/2PACX-1vRXu6o48-7QYKuKsM9FiX7bl2Y9U9fU41J1sK8WBff-GDKT9CjbQD8mLsiNNUAmvwKLCZ04QGoOmzTF/pub?gid=2068522996&single=true&output=csv";

  interface Job {
    title: string;
    active: string;
    department: string;
    location: string;
    summary: string;
    datePosted: string;
    applyUrl: string;
    employmentType: string;
  }

  function parseCSV(text: string): Job[] {
    const lines = text.trim().split(/\r?\n/);
    if (lines.length < 2) return [];

    const headers = lines[0].split(",").map(h => h.trim());

    return lines.slice(1).map((line, index) => {
      const values = line.match(/(?:"[^"]*"|[^,])+/g) || [];
      const entry: Record<string, string> = {};

      headers.forEach((header, i) => {
        let val = values[i] ? values[i].trim() : "";
        if (val.startsWith('"') && val.endsWith('"')) {
          val = val.slice(1, -1).replace(/""/g, '"');
        }
        entry[header] = val;
      });

      return {
        title: entry["Title"] || "",
        active: entry["Active"] || "N",
        department: entry["Department"] || "Uncategorized",
        location: entry["Location"] || "",
        summary: entry["Summary"] || "",
        datePosted: entry["DatePosted"] || "",
        applyUrl: entry["ApplyURL"] || "",
        employmentType: "Full-time"
      };
    });
  }

  function formatDate(dateStr: string): string {
    if (!dateStr) return "Recently";
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    return d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
  }

  const cardTemplate = document.getElementById("job-card-template") as HTMLTemplateElement;

  function buildJobCard(job: Job): HTMLLIElement {
    const fragment = cardTemplate.content.cloneNode(true) as DocumentFragment;
    const card = fragment.querySelector("[data-job]") as HTMLLIElement;

    const searchBlob =
      `${job.title} ${job.location} ${job.department} ${job.summary}`.toLowerCase();
    card.dataset.department = job.department;
    card.dataset.search = searchBlob;

    (card.querySelector('[data-field="department"]') as HTMLElement).textContent = job.department;
    (card.querySelector('[data-field="title"]') as HTMLElement).textContent = job.title;
    (card.querySelector('[data-field="location"]') as HTMLElement).textContent = job.location;
    (card.querySelector('[data-field="employment-type"]') as HTMLElement).textContent =
      job.employmentType;
    (card.querySelector('[data-field="date-posted"]') as HTMLElement).textContent = formatDate(
      job.datePosted
    );
    (card.querySelector('[data-field="summary"]') as HTMLElement).textContent = job.summary;

    const applyLink = card.querySelector('[data-field="apply-link"]') as HTMLAnchorElement;
    applyLink.href = job.applyUrl || "#";

    return card;
  }

  const searchInput = document.getElementById("job-search") as HTMLInputElement;
  const deptSelect = document.getElementById("job-department") as HTMLSelectElement;
  const jobList = document.getElementById("job-list") as HTMLUListElement;
  const countEl = document.getElementById("job-count") as HTMLParagraphElement;
  const noResults = document.getElementById("no-results") as HTMLDivElement;
  const clearBtn = document.getElementById("clear-filters") as HTMLButtonElement | null;
  const loadMoreBtn = document.getElementById("load-more-btn") as HTMLButtonElement | null;
  const loadMoreContainer = document.getElementById("load-more-container") as HTMLDivElement | null;

  const PAGE_SIZE = 10;
  let visibleLimit = PAGE_SIZE;
  let jobItems: HTMLLIElement[] = [];

  function applyFilters() {
    const query = searchInput.value.trim().toLowerCase();
    const dept = deptSelect.value;

    const matchingItems = jobItems.filter(item => {
      const matchesDept = dept === "All" || item.dataset.department === dept;
      const matchesQuery = !query || (item.dataset.search ?? "").includes(query);
      return matchesDept && matchesQuery;
    });

    jobItems.forEach(item => item.classList.add("hidden"));

    const itemsToDisplay = matchingItems.slice(0, visibleLimit);
    itemsToDisplay.forEach(item => item.classList.remove("hidden"));

    const totalMatching = matchingItems.length;
    const currentlyShowing = itemsToDisplay.length;

    countEl.textContent = `Showing ${currentlyShowing} of ${totalMatching} ${totalMatching === 1 ? "role" : "roles"}`;

    noResults.classList.toggle("hidden", totalMatching !== 0);
    noResults.classList.toggle("flex", totalMatching === 0);

    if (loadMoreContainer) {
      const hasMore = currentlyShowing < totalMatching;
      loadMoreContainer.classList.toggle("hidden", !hasMore);
      loadMoreContainer.classList.toggle("flex", hasMore);
    }
  }

  function populateDepartments(jobs: Job[]) {
    const departments = ["All", ...Array.from(new Set(jobs.map(j => j.department))).sort()];
    deptSelect.innerHTML = "";
    departments.forEach(dept => {
      const option = document.createElement("option");
      option.value = dept;
      option.textContent = dept === "All" ? "All departments" : dept;
      deptSelect.appendChild(option);
    });
  }

  async function loadJobs() {
    try {
      const res = await fetch(CSV_URL, { cache: "no-store" });
      const csvText = await res.text();
      const jobs = parseCSV(csvText)
        .filter(
          job =>
            job.title.trim() !== "" &&
            job.datePosted.trim() !== "" &&
            job.active.toLowerCase() === "y"
        )
        .sort((a, b) => new Date(b.datePosted).getTime() - new Date(a.datePosted).getTime());

      populateDepartments(jobs);
      jobList.innerHTML = "";
      jobItems = jobs.map(buildJobCard);
      jobItems.forEach(item => jobList.appendChild(item));

      applyFilters();
    } catch (error) {
      console.error("Failed to fetch jobs CSV:", error);
      countEl.textContent = "Unable to load roles right now. Please refresh or check back shortly.";
    }
  }

  loadMoreBtn?.addEventListener("click", () => {
    visibleLimit += PAGE_SIZE;
    applyFilters();
  });

  searchInput.addEventListener("input", () => {
    visibleLimit = PAGE_SIZE;
    applyFilters();
  });

  deptSelect.addEventListener("change", () => {
    visibleLimit = PAGE_SIZE;
    applyFilters();
  });

  clearBtn?.addEventListener("click", () => {
    searchInput.value = "";
    deptSelect.value = "All";
    visibleLimit = PAGE_SIZE;
    applyFilters();
  });

  loadJobs();
</script>
