---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import Button from "../components/Button.astro";
import { contactInfo } from "../data/site";

const pageTitle = "Contact Us";
const metaDescription =
  "Start a search, or ask us about the market. Whether you are hiring talent or looking for your next role, get in touch with our team.";
---

<Layout title={pageTitle} description={metaDescription}>
  <PageHero
    eyebrow="Contact Us"
    title="Start a search, or just ask us what the market looks like."
    intro="Tell us about the role and we will come back with honest feedback on the talent pool, realistic timing, and what it will take to land the hire."
    image="https://cdn.magicpatterns.com/patterns/generated-images/44c3edc6-a893-447c-9130-5bfa97520801.jpg"
    imageAlt="Modern professional office building exterior"
  />

  <section aria-labelledby="contact-heading" class="bg-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
        {/* Main Form Area */}
        <div>
          <ContactForm />
        </div>

        {/* Sidebar Info */}
        <aside class="space-y-6">
          {/* Redesigned Careers Box — Moved to Top */}
          <div class="border border-brand-accent/10 bg-brand-primary-soft/40 p-7">
            <div class="flex items-center gap-3">
              <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-primary/10 text-brand-primary">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-5 w-5"
                  aria-hidden="true">
                  <rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              </div>
              <h2 class="font-serif text-xl font-bold text-brand-accent">
                Looking for open roles?
              </h2>
            </div>
            <p class="mt-3 font-sans text-sm leading-relaxed text-brand-accent/75">
              You can apply directly to active positions on our careers board, or submit a general
              application using the Candidate tab on this page.
            </p>
            <Button
              href="/careers"
              variant="primary"
              class="mt-5 inline-block text-sm font-semibold">
              Browse open roles &rarr;
            </Button>
          </div>

          {/* Building Image */}
          <div class="relative overflow-hidden border border-brand-accent/10">
            <img
              src="https://cdn.magicpatterns.com/patterns/generated-images/44c3edc6-a893-447c-9130-5bfa97520801.jpg"
              alt="Office building exterior"
              class="aspect-3/2 w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <span aria-hidden="true" class="absolute bottom-0 left-0 h-1.5 w-24 bg-brand-secondary"
            ></span>
          </div>

          {/* Direct Contact Details */}
          <div class="border border-brand-accent/10 bg-white p-7">
            <h2
              class="font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-accent/45">
              Direct contact
            </h2>
            <ul class="mt-5 space-y-5 font-sans text-[15px] text-brand-accent/80">
              <li class="flex gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mt-0.5 h-4 w-4 shrink-0 text-brand-primary"
                  aria-hidden="true">
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                  ></path>
                </svg>
                <a
                  href={contactInfo.phoneHref}
                  class="font-medium transition-colors hover:text-brand-primary-dark">
                  {contactInfo.phone}
                </a>
              </li>
              <li class="flex gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mt-0.5 h-4 w-4 shrink-0 text-brand-primary"
                  aria-hidden="true">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
                <a
                  href={`mailto:${contactInfo.email}`}
                  class="break-all font-medium transition-colors hover:text-brand-primary-dark">
                  {contactInfo.email}
                </a>
              </li>
              <li class="flex gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mt-0.5 h-4 w-4 shrink-0 text-brand-primary"
                  aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <address class="not-italic leading-relaxed">
                  {
                    contactInfo.addressLines.map((line: string) => (
                      <span class="block">{line}</span>
                    ))
                  }
                </address>
              </li>
              <li class="flex gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mt-0.5 h-4 w-4 shrink-0 text-brand-primary"
                  aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>{contactInfo.hours}</span>
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>
