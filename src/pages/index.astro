---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import CTASection from "../components/CTA.astro";
import SectionHeader from "../components/UI/SectionHeader.astro";

interface StatItem {
  value: string;
  number: number | null;
  suffix: string;
  label: string;
}

const stats: StatItem[] = [
  {
    value: "50+",
    number: 50,
    suffix: "+",
    label: "Years of combined recruiting experience"
  },
  {
    value: "98%",
    number: 98,
    suffix: "%",
    label: "Retained search completion rate"
  },
  {
    value: "24hr",
    number: 24,
    suffix: "hr",
    label: "Average submission response time"
  },
  {
    value: "Nationwide",
    number: null,
    suffix: "",
    label: "Search reach across U.S. industry"
  }
];

const services = [
  {
    slug: "executive-recruitment",
    name: "Executive Recruitment",
    subtitle: "Retained Search",
    tagline: "Confidential, dedicated search for leadership-level hiring.",
    whatItIs:
      "An exclusive search partnership for executive and leadership-level roles, dedicated recruiting resources, a customized strategy, and access to passive candidates. 98% search success rate, white-glove and confidential from first call to start date.",
    bestFor: ["C-suite, VP, and director-level leadership hires", "Confidential replacements where discretion is essential", "Roles where the right person is not actively job-hunting"],
    image: "https://cdn.magicpatterns.com/patterns/generated-images/6d4a5a34-605a-47f6-8686-998d56a1f7ad.jpg",
    imageAlt: "Two executives in a private boardroom discussion",
    badge: "Signature Service"
  },
  {
    slug: "direct-hire",
    name: "Direct Hire Placement",
    subtitle: "Permanent Placement",
    tagline: "Permanent placement, sourced and vetted end to end.",
    whatItIs: "Permanent placement for critical roles where we manage sourcing, screening, and offer acceptance. Fees are a percentage of first-year salary, payable only upon a successful hire.",
    bestFor: [
      "Engineering, quality, EHS, supply chain, HR, and operations roles",
      "Companies replacing a key contributor or adding headcount",
      "Hard-to-fill roles where posting a job has not worked"
    ],
    image: "https://cdn.magicpatterns.com/patterns/generated-images/415753f7-452d-4984-b7aa-980617a5bea6.jpg",
    imageAlt: "A hiring manager welcoming a newly placed employee in an industrial office"
  },
  {
    slug: "contract-staffing",
    name: "Contract Staffing",
    subtitle: "Interim & Project Support",
    tagline: "Flexible technical talent for project work and coverage gaps.",
    whatItIs:
      "Experienced professionals on our payroll, ready for project demands, seasonal workloads, or interim leadership needs. Contractors can convert to direct hire with compliance, insurance, and onboarding handled on our end.",
    bestFor: ["Launches, shutdowns, capital projects, and seasonal ramps", "Leave coverage and interim technical leadership", "Teams that want to work with someone before committing"],
    image: "https://cdn.magicpatterns.com/patterns/generated-images/7fe8f4b2-9c3b-43ff-a757-d57c3614df66.jpg",
    imageAlt: "Contract technicians working on a capital project inside a manufacturing plant"
  },
  {
    slug: "rpo",
    name: "Recruitment Process Outsourcing (RPO)",
    subtitle: "Embedded Partnership",
    tagline: "Your recruiting team, scaled up without adding headcount.",
    whatItIs:
      "An embedded recruiting partnership for sustained or high-volume hiring. We run requisitions end to end under your employer brand, so hiring managers see consistent quality without carrying the full recruiting load internally.",
    bestFor: [
      "Sustained hiring volume that has outgrown your internal team capacity",
      "Organizations that want recruiting handled under their own employer brand",
      "Companies scaling headcount quickly across multiple roles or sites"
    ],
    image: "https://cdn.magicpatterns.com/patterns/generated-images/135de5e8-f67b-4978-bc03-f88fe5091c1f.jpg",
    imageAlt: "A consultant leading a hiring process working session with an operations team"
  },
  {
    slug: "greenfield-brownfield",
    name: "Greenfield & Brownfield Recruitment",
    subtitle: "Facility Launches & Ramps",
    tagline: "Project-based recruiting for facility launches and expansions.",
    whatItIs:
      "Project-based recruiting for facility startups, plant expansions, acquisitions, and large-scale workforce growth built to hit aggressive, fixed hiring timelines from first hire to full staffing.",
    bestFor: ["New facility launches and plant startups", "Acquisitions and large-scale workforce growth initiatives", "Expansions with aggressive, fixed hiring timelines"],
    image: "https://cdn.magicpatterns.com/patterns/generated-images/a0dfae42-966e-4e92-8b70-76d85e3be4c2.jpg",
    imageAlt: "Warehouse operations team managing inventory in a large distribution facility"
  },
  {
    slug: "recruiter-for-hire",
    name: "Recruiter for Hire",
    subtitle: "Hourly Support",
    tagline: "Hourly recruiting support, without a placement-fee commitment.",
    whatItIs:
      "Hourly support for sourcing, screening, interviewing, and hiring assistance with expert recruiting resources without a traditional placement-fee structure. Ideal for targeted or ongoing projects that flex with demand.",
    bestFor: ["Internal teams that need extra recruiting hands, not another agency fee", "Targeted hiring projects with a defined scope", "Ongoing support that flexes up or down with demand"],
    image: "https://cdn.magicpatterns.com/patterns/generated-images/f52c5b3a-ec06-48ab-8167-b0088a13037b.jpg",
    imageAlt: "Automated production line inside a modern manufacturing plant"
  }
];

const industries = [
  {
    name: "Manufacturing",
    description: "From plant leadership and operations to skilled trades and production support, we build high-performing teams that drive productivity, quality, and immediate impact.",
    image: "https://cdn.magicpatterns.com/patterns/generated-images/f2b14831-d44e-4040-a984-08ce782d5f22.jpg",
    imageAlt: "Manufacturing and plant floor operations",
    roles: ["Plant Manager", "Process Engineer", "Maintenance Manager", "Quality Manager"]
  },
  {
    name: "Engineering & Construction",
    description: "Connecting top talent across mechanical, electrical, manufacturing, quality, and structural disciplines, alongside skilled construction and project management professionals.",
    image: "https://cdn.magicpatterns.com/patterns/generated-images/8eeabe6d-c66a-4049-b5a4-afc43f76dbe9.jpg",
    imageAlt: "Engineering design and construction site management",
    roles: ["Mechanical Engineer", "Electrical Engineer", "Project Manager", "Controls Specialist"]
  },
  {
    name: "Aerospace & Defense",
    description: "Specializing in precision, compliance, and technical expertise required for highly regulated, mission-critical defense and aerospace environments.",
    image: "https://cdn.magicpatterns.com/patterns/generated-images/787727ef-fe41-4eea-9e31-12282675c434.jpg",
    imageAlt: "Aerospace manufacturing and defense engineering",
    roles: ["Quality Assurance Lead", "Manufacturing Engineer", "EHS Director", "Systems Engineer"]
  },
  {
    name: "Information Technology",
    description: "Uniting Finance, Accounting, HR, IT, and Academics to drive financial performance, digital infrastructure, organizational growth, and strategic business leadership.",
    image: "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=800&q=80",
    imageAlt: "Server racks and digital cloud infrastructure",
    roles: ["Software Engineer", "Systems Architect", "IT Manager", "Data Analyst"]
  },
  {
    name: "Professional Services",
    description: "Uniting Finance, Accounting, HR, IT, and Academics to drive financial performance, digital infrastructure, organizational growth, and strategic business leadership.",
    image: "https://cdn.magicpatterns.com/patterns/generated-images/5526439e-9324-41e1-8079-0e0f553fad6f.jpg",
    imageAlt: "Modern office environment and professional services team",
    roles: ["Financial Analyst", "HR Director", "C Suite", "Consultant"]
  }
];

const differentiators = [
  {
    title: "A network, not a database",
    body: "The people we place are usually not applying to anything. They are known to us — from years of working the same plants, the same conferences, and the same technical communities."
  },
  {
    title: "Consultative from the first call",
    body: "We will tell you if the comp is off, if the title is wrong, or if the search will take longer than you hope. Honest market feedback beats a stack of resumes."
  },
  {
    title: "Industry depth, not generalists",
    body: "Manufacturing, engineering, skilled trades, supply chain, quality, EHS, HR, and professional operations. That is the whole list, and it is deliberately short."
  },
  {
    title: "Any size, any volume",
    body: "One retained executive search or fifty contract technicians for a launch. Growing manufacturers and Fortune 500 operations get the same senior attention."
  }
];

const testimonials = [
  {
    quote:
      "I’ve worked with Aaron as a trusted recruiting resource for over 18 years. What sets him apart is his unmatched character, work ethic, and commitment to integrity. He is exceptionally professional, knowledgeable about local industry, and dedicated to finding the exact skill fit for every open role. Aaron is always my very first call, and I highly recommend him and his team.",
    title: "HR Manager",
    company: "Tier 1 Automotive Supplier"
  },
  {
    quote:
      "Aaron isn't just a recruiter; he is a true partner who deeply understands the manufacturing industry. He asks the right questions, maintains clear communication throughout the search, and consistently delivers qualified candidates who fit both our technical needs and company culture. I wouldn\'t hesitate to recommend Aaron and his team to any organization.",
    title: "Director of Operations",
    company: "Manufacturing Company"
  },
  {
    quote:
      "I’ve worked with Aaron for nearly a decade with consistently positive results across technical, operations, and leadership roles. He excels at finding qualified passive candidates with niche skills by fishing where no one else is looking. Aaron’s professionalism, deep capability, and dedicated efforts make him a essential partner, and I recommend him every chance I get.",
    title: "HR Manager",
    company: "Global Automotive Manufacturer"
  }
];

const metaDescription =
  "Beacon Search Group recruits for manufacturers, engineering firms, and industrial operations nationwide, from skilled trades to executive leadership. Retained search, direct hire, and more.";
---

<Layout description={metaDescription}>
  <section class="relative flex min-h-160 w-full items-center overflow-hidden bg-slate-950 text-white">
    <!-- Fallback Background Gradient -->
    <div class="absolute inset-0 bg-linear-to-r from-slate-950 via-slate-900 to-slate-800"></div>

    <!-- Background Image -->
    <img
      src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=2000&q=80"
      alt="Industrial engineer working in high-tech manufacturing facility"
      class="absolute inset-0 h-full w-full object-cover object-right opacity-70 lg:object-center"
      loading="eager"
      decoding="async"
    />

    <!-- Desktop Gradient Overlay -->
    <div
      aria-hidden="true"
      class="absolute inset-0 hidden w-3/4 bg-linear-to-r from-slate-950 via-slate-950/90 to-transparent lg:block">
    </div>

    <!-- Mobile & Tablet Gradient Overlay -->
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-linear-to-t from-slate-950 via-slate-950/90 to-slate-950/50 lg:hidden">
    </div>

    <!-- Content Container -->
    <div class="relative z-10 mx-auto w-full max-w-7xl px-5 py-16 sm:px-8 lg:px-12 lg:py-28">
      <div class="max-w-2xl">
        <!-- Tagline / Eyebrow -->
        <p class="flex items-center gap-3 font-sans text-xs font-semibold uppercase tracking-widest text-brand-primary">
          <span
            aria-hidden="true"
            class="h-px w-6 bg-brand-secondary"
          ></span>
          Specialized Recruiting &amp; Executive Search
        </p>

        <!-- Main Headline -->
        <h1 class="mt-4 font-serif text-4xl font-bold leading-tight text-white sm:text-5xl lg:text-6xl">
          Lighting the Way In{" "}
          <span class="text-brand-primary">Talent Innovation</span>
        </h1>

        <!-- Subheadline / Body Text -->
        <p class="mt-6 font-sans text-base leading-relaxed text-slate-200/90 sm:text-lg">
          We place engineers, skilled tradespeople, and operations leaders with manufacturers and industrial companies. From a single hard-to-fill role to a full plant ramp-up.
        </p>

        <!-- CTAs Using Button.astro -->
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
          <Button
            href="/contact"
            variant="primary"
            size="lg">
            Find talent
          </Button>

          <Button
            href="/careers"
            variant="outlineLight"
            size="lg">
            Find a role
          </Button>
        </div>
      </div>
    </div>
  </section>

  {/* ================= STATS BAR ================= */}
  <section
    aria-label="Beacon Search Group at a glance"
    class="w-full bg-brand-primary-soft">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px overflow-hidden bg-brand-accent/10 sm:px-0 lg:grid-cols-4">
      {
        stats.map((stat: StatItem) => (
          <div class="bg-brand-primary-soft px-5 py-8 text-center sm:px-8">
            <p class="font-serif text-2xl font-bold text-brand-accent sm:text-3xl">
              {stat.number !== null ? (
                <span
                  class="stat-counter"
                  data-target={stat.number}
                  data-suffix={stat.suffix}>
                  0{stat.suffix}
                </span>
              ) : (
                <span>{stat.value}</span>
              )}
            </p>
            <p class="mx-auto mt-2 max-w-[16rem] font-sans text-[13px] leading-snug text-brand-accent/60">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* ================= SERVICES OVERVIEW ================= */}
  <section
    class="mx-auto max-w-7xl px-5 py-12 sm:px-8 md:py-20"
    aria-labelledby="services-heading">
    {/* Header with high-visibility CTA on the right */}
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <SectionHeader
        eyebrow="Our Services"
        title="The right engagement for the role you're filling"
        description="From one retained executive search to a full contract workforce ramp-up, the engagement flexes to how you actually need to hire."
      />
      <div class="shrink-0 pb-1">
        <a
          href="/services"
          class="inline-flex items-center gap-2 rounded-md px-5 py-3 font-sans text-sm font-semibold text-brand-secondary transition-colors focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2">
          View All Services
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M14 5l7 7m0 0l-7 7m7-7H3"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <div
      class="mt-10 lg:mt-12 lg:grid lg:grid-cols-12 lg:gap-8"
      id="services-tabs">
      <nav
        class="hidden lg:col-span-4 lg:flex lg:flex-col lg:border-r lg:border-brand-accent/10 lg:pr-6"
        aria-label="Services List">
        {
          services.map((service, index) => (
            <button
              type="button"
              data-service-tab={service.slug}
              aria-selected={index === 0 ? "true" : "false"}
              class={`service-tab-btn group relative flex cursor-pointer items-center gap-4 border-b border-brand-accent/10 py-5 text-left transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary ${
                index === 0 ? "bg-brand-primary-soft/30 pl-5" : "pl-4 hover:bg-brand-primary-soft/15"
              }`}>
              <span
                aria-hidden="true"
                class={`active-indicator absolute left-0 top-0 h-full w-1 bg-brand-primary transition-opacity duration-200 ${index === 0 ? "opacity-100" : "opacity-0"}`}
              />

              <div class="min-w-0 flex-1 pr-3">
                <div class="flex items-center gap-2">
                  <span class="font-sans text-[9px] font-semibold uppercase tracking-[0.15em] text-brand-secondary">{service.subtitle}</span>
                  {service.badge && <span class="bg-brand-secondary/20 px-1.5 py-0.5 font-sans text-[8px] font-bold uppercase tracking-wider text-brand-accent">{service.badge}</span>}
                </div>

                <h3 class={`mt-1 font-serif text-base font-bold transition-colors duration-200 ${index === 0 ? "text-brand-accent" : "text-brand-accent/75 group-hover:text-brand-accent"}`}>
                  {service.name}
                </h3>
              </div>

              <svg
                class={`mr-4 h-4 w-4 shrink-0 transition-all duration-200 ${
                  index === 0 ? "translate-x-0 text-brand-primary opacity-100" : "-translate-x-1 text-brand-accent/20 opacity-0 group-hover:translate-x-0 group-hover:opacity-100"
                }`}
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </button>
          ))
        }
      </nav>
      <div class="lg:hidden">
        <div class="border-t border-brand-accent/10">
          {
            services.map((service, index) => (
              <div
                class="mobile-service border-b border-brand-accent/10"
                data-mobile-service={service.slug}>
                <button
                  type="button"
                  class="mobile-service-btn group flex w-full items-center gap-4 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
                  data-mobile-service-btn={service.slug}
                  aria-expanded={index === 0 ? "true" : "false"}
                  aria-controls={`mobile-panel-${service.slug}`}>
                  <span class="min-w-0 flex-1">
                    <span class="block font-sans text-[9px] font-semibold uppercase tracking-[0.15em] text-brand-secondary">{service.subtitle}</span>
                    <span class="mt-0.5 block font-serif text-lg font-bold text-brand-accent">{service.name}</span>
                  </span>

                  {service.badge && (
                    <span class="hidden bg-brand-secondary/20 px-2 py-1 font-sans text-[8px] font-bold uppercase tracking-wider text-brand-accent sm:inline-block">{service.badge}</span>
                  )}

                  <span
                    class="mobile-service-icon flex h-7 w-7 shrink-0 items-center justify-center border border-brand-accent/15 text-brand-accent transition-all duration-200"
                    data-mobile-icon={service.slug}
                    aria-hidden="true">
                    <svg
                      class={`h-3.5 w-3.5 ${index === 0 ? "hidden" : "block"}`}
                      data-plus-icon={service.slug}
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 5v14M5 12h14"
                      />
                    </svg>
                    <svg
                      class={`h-3.5 w-3.5 ${index === 0 ? "block" : "hidden"}`}
                      data-minus-icon={service.slug}
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 12h14"
                      />
                    </svg>
                  </span>
                </button>

                <div
                  id={`mobile-panel-${service.slug}`}
                  class={`mobile-service-panel overflow-hidden transition-all duration-300 ${index === 0 ? "max-h-225 opacity-100" : "max-h-0 opacity-0"}`}
                  data-mobile-panel={service.slug}>
                  <div class="pb-6">
                    <div class="relative aspect-video overflow-hidden border border-brand-accent/10">
                      <img
                        src={service.image}
                        alt={service.imageAlt}
                        class="h-full w-full object-cover"
                        loading="lazy"
                        decoding="async"
                      />
                      <div
                        aria-hidden="true"
                        class="absolute inset-0 bg-brand-accent/10"
                      />
                    </div>

                    <div class="mt-5">
                      <p class="font-sans text-sm leading-relaxed text-brand-accent/75">{service.whatItIs}</p>

                      <div class="mt-5 border-t border-brand-accent/10 pt-4">
                        <p class="font-sans text-[9px] font-semibold uppercase tracking-[0.16em] text-brand-accent/45">Best Suited For</p>

                        <div class="mt-3 flex flex-wrap gap-2">
                          {service.bestFor.map(item => (
                            <span class="border border-brand-accent/10 bg-brand-primary-soft/40 px-2.5 py-1.5 font-sans text-[11px] leading-tight text-brand-accent/75">{item}</span>
                          ))}
                        </div>
                      </div>

                      <div class="mt-5">
                        <a
                          href={`/services#${service.slug}`}
                          class="group inline-flex items-center gap-2 font-sans text-xs font-semibold text-brand-primary transition-colors hover:text-blue-800">
                          Learn more about {service.name}
                          <svg
                            class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                            aria-hidden="true">
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M14 5l7 7m0 0l-7 7m7-7H3"
                            />
                          </svg>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      {
        /* =========================================================
      DESKTOP SERVICE DETAIL PANEL
      ========================================================= */
      }
      <div class="hidden lg:col-span-8 lg:block">
        {
          services.map((service, index) => (
            <div
              id={`panel-${service.slug}`}
              data-service-panel={service.slug}
              class={`service-panel transition-all duration-300 ${index === 0 ? "block opacity-100" : "hidden opacity-0"}`}>
              <div class="relative overflow-hidden border border-brand-accent/10 bg-brand-primary-soft/25 shadow-xs">
                {/* Image with overlay title */}
                <div class="relative aspect-16/7 overflow-hidden">
                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    class="h-full w-full object-cover"
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />

                  <div
                    aria-hidden="true"
                    class="absolute inset-0 bg-linear-to-t from-brand-accent/80 via-brand-accent/20 to-transparent"
                  />

                  <div class="absolute bottom-5 left-6 sm:left-8">
                    <p class="font-sans text-[9px] font-semibold uppercase tracking-[0.2em] text-orange-500">{service.subtitle}</p>
                    <h3 class="mt-1 font-serif text-2xl font-bold text-white sm:text-3xl">{service.name}</h3>
                  </div>

                  {service.badge && (
                    <span class="absolute right-5 top-5 bg-brand-secondary px-3 py-1.5 font-sans text-[9px] font-semibold uppercase tracking-[0.15em] text-brand-accent">{service.badge}</span>
                  )}
                </div>

                {/* Bottom Content */}
                <div class="relative grid gap-7 p-6 sm:p-8 md:grid-cols-12 md:gap-8">
                  <div class="md:col-span-7">
                    <p class="font-sans text-sm leading-relaxed text-brand-accent/75">{service.whatItIs}</p>

                    <div class="mt-6">
                      <a
                        href={`/services#${service.slug}`}
                        class="group inline-flex items-center gap-2 font-sans text-sm font-semibold text-brand-primary transition-colors hover:text-blue-800">
                        Learn more about {service.name}
                        <svg
                          class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                          aria-hidden="true">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M14 5l7 7m0 0l-7 7m7-7H3"
                          />
                        </svg>
                      </a>
                    </div>
                  </div>

                  <div class="md:col-span-5">
                    <div class="border-l border-brand-accent/10 pl-6">
                      <p class="font-sans text-[9px] font-semibold uppercase tracking-[0.16em] text-brand-accent/45">Best Suited For</p>

                      <div class="mt-3 flex flex-wrap gap-2">
                        {service.bestFor.map(item => (
                          <span class="border border-brand-accent/10 bg-white/60 px-2.5 py-1.5 font-sans text-[11px] leading-tight text-brand-accent/70">{item}</span>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ================= INDUSTRIES SECTION ================= */}
  <section class="relative overflow-hidden bg-brand-accent py-16 text-white md:py-20">
  <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeader
      theme="dark"
      eyebrow="Industries We Serve"
      title="We know these markets because we only work in them"
