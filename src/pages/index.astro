---
import Layout from "../layouts/Layout.astro";
import Button from '../components/Button.astro';
import CTASection from '../components/CTA.astro';
import SectionHeader from '../components/UI/SectionHeader.astro';

interface StatItem {
  value: string;
  number: number | null;
  suffix: string;
  label: string;
}

const stats: StatItem[] = [
  { value: '50+', number: 50, suffix: '+', label: 'Years of combined recruiting experience' },
  { value: '98%', number: 98, suffix: '%', label: 'Retained search completion rate' },
  { value: '24hr', number: 24, suffix: 'hr', label: 'Average submission response time' },
  { value: 'Nationwide', number: null, suffix: '', label: 'Search reach across U.S. industry' },
];

const services = [
  {
    slug: 'executive-recruitment',
    name: 'Executive Recruitment',
    subtitle: 'Retained Search',
    tagline: 'Confidential, dedicated search for leadership-level hiring.',
    whatItIs:
      'An exclusive search partnership for executive and leadership-level roles, dedicated recruiting resources, a customized strategy, and access to passive candidates. 98% search success rate, white-glove and confidential from first call to start date.',
    bestFor: [
      'C-suite, VP, and director-level leadership hires',
      'Confidential replacements where discretion is essential',
      'Roles where the right person is not actively job-hunting',
    ],
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/6d4a5a34-605a-47f6-8686-998d56a1f7ad.jpg',
    imageAlt: 'Two executives in a private boardroom discussion',
    badge: 'Signature Service',
  },
  {
    slug: 'direct-hire',
    name: 'Direct Hire Placement',
    subtitle: 'Permanent Placement',
    tagline: 'Permanent placement, sourced and vetted end to end.',
    whatItIs:
      'Permanent placement for critical roles where we manage sourcing, screening, and offer acceptance. Fees are a percentage of first-year salary, payable only upon a successful hire.',
    bestFor: [
      'Engineering, quality, EHS, supply chain, HR, and operations roles',
      'Companies replacing a key contributor or adding headcount',
      'Hard-to-fill roles where posting a job has not worked',
    ],
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/415753f7-452d-4984-b7aa-980617a5bea6.jpg',
    imageAlt: 'A hiring manager welcoming a newly placed employee in an industrial office',
  },
  {
    slug: 'contract-staffing',
    name: 'Contract Staffing',
    subtitle: 'Interim & Project Support',
    tagline: 'Flexible technical talent for project work and coverage gaps.',
    whatItIs:
      'Experienced professionals on our payroll, ready for project demands, seasonal workloads, or interim leadership needs. Contractors can convert to direct hire with compliance, insurance, and onboarding handled on our end.',
    bestFor: [
      'Launches, shutdowns, capital projects, and seasonal ramps',
      'Leave coverage and interim technical leadership',
      'Teams that want to work with someone before committing',
    ],
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/7fe8f4b2-9c3b-43ff-a757-d57c3614df66.jpg',
    imageAlt: 'Contract technicians working on a capital project inside a manufacturing plant',
  },
  {
    slug: 'rpo',
    name: 'Recruitment Process Outsourcing (RPO)',
    subtitle: 'Embedded Partnership',
    tagline: 'Your recruiting team, scaled up without adding headcount.',
    whatItIs:
      'An embedded recruiting partnership for sustained or high-volume hiring. We run requisitions end to end under your employer brand, so hiring managers see consistent quality without carrying the full recruiting load internally.',
    bestFor: [
      'Sustained hiring volume that has outgrown your internal team capacity',
      'Organizations that want recruiting handled under their own employer brand',
      'Companies scaling headcount quickly across multiple roles or sites',
    ],
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/135de5e8-f67b-4978-bc03-f88fe5091c1f.jpg',
    imageAlt: 'A consultant leading a hiring process working session with an operations team',
  },
  {
    slug: 'greenfield-brownfield',
    name: 'Greenfield & Brownfield Recruitment',
    subtitle: 'Facility Launches & Ramps',
    tagline: 'Project-based recruiting for facility launches and expansions.',
    whatItIs:
      'Project-based recruiting for facility startups, plant expansions, acquisitions, and large-scale workforce growth built to hit aggressive, fixed hiring timelines from first hire to full staffing.',
    bestFor: [
      'New facility launches and plant startups',
      'Acquisitions and large-scale workforce growth initiatives',
      'Expansions with aggressive, fixed hiring timelines',
    ],
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/a0dfae42-966e-4e92-8b70-76d85e3be4c2.jpg',
    imageAlt: 'Warehouse operations team managing inventory in a large distribution facility',
  },
  {
    slug: 'recruiter-for-hire',
    name: 'Recruiter for Hire',
    subtitle: 'Hourly Support',
    tagline: 'Hourly recruiting support, without a placement-fee commitment.',
    whatItIs:
      'Hourly support for sourcing, screening, interviewing, and hiring assistance with expert recruiting resources without a traditional placement-fee structure. Ideal for targeted or ongoing projects that flex with demand.',
    bestFor: [
      'Internal teams that need extra recruiting hands, not another agency fee',
      'Targeted hiring projects with a defined scope',
      'Ongoing support that flexes up or down with demand',
    ],
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/f52c5b3a-ec06-48ab-8167-b0088a13037b.jpg',
    imageAlt: 'Automated production line inside a modern manufacturing plant',
  },
];

// Inline SVG path data, keyed to match the `icon` field above
const iconPaths: Record<string, string> = {
  target: 'M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM12 16a4 4 0 100-8 4 4 0 000 8zM12 12h.01',
  clock: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  layers: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  building: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  'user-check': 'M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zm10 0l2 2 4-4',
};

const industries = [
  {
    name: 'Manufacturing & Heavy Industry',
    description: 'From plant leadership and operations to skilled trades and production support, we build high-performing teams that drive productivity, quality, and immediate impact.',
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/f2b14831-d44e-4040-a984-08ce782d5f22.jpg',
    imageAlt: 'Manufacturing and plant floor operations',
    roles: ['Plant Manager', 'Process Engineer', 'Maintenance Manager', 'Quality Manager'],
  },
  {
    name: 'Engineering & Construction',
    description: 'Connecting top talent across mechanical, electrical, manufacturing, quality, and structural disciplines, alongside skilled construction and project management professionals.',
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/8eeabe6d-c66a-4049-b5a4-afc43f76dbe9.jpg',
    imageAlt: 'Engineering design and construction site management',
    roles: ['Mechanical Engineer', 'Electrical Engineer', 'Project Manager', 'Controls Specialist'],
  },
  {
    name: 'Aerospace & Defense',
    description: 'Specializing in precision, compliance, and technical expertise required for highly regulated, mission-critical defense and aerospace environments.',
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/787727ef-fe41-4eea-9e31-12282675c434.jpg',
    imageAlt: 'Aerospace manufacturing and defense engineering',
    roles: ['Quality Assurance Lead', 'Manufacturing Engineer', 'EHS Director', 'Systems Engineer'],
  },
  {
    name: 'Corporate, Tech & Professional Services',
    description: 'Uniting Finance, Accounting, HR, IT, and Academics to drive financial performance, digital infrastructure, organizational growth, and strategic business leadership.',
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/5526439e-9324-41e1-8079-0e0f553fad6f.jpg',
    imageAlt: 'Modern office environment and professional services team',
    roles: ['Financial Analyst', 'HR Director', 'Software Engineer', 'Systems Architect'],
  },
];

const differentiators = [
  {
    title: 'A network, not a database',
    body: 'The people we place are usually not applying to anything. They are known to us — from years of working the same plants, the same conferences, and the same technical communities.',
  },
  {
    title: 'Consultative from the first call',
    body: 'We will tell you if the comp is off, if the title is wrong, or if the search will take longer than you hope. Honest market feedback beats a stack of resumes.',
  },
  {
    title: 'Industry depth, not generalists',
    body: 'Manufacturing, engineering, skilled trades, supply chain, quality, EHS, HR, and professional operations. That is the whole list, and it is deliberately short.',
  },
  {
    title: 'Any size, any volume',
    body: 'One retained executive search or fifty contract technicians for a launch. Growing manufacturers and Fortune 500 operations get the same senior attention.',
  },
];

const testimonials = [
  {
    quote:
      'Aaron has been my go-to recruiting partner for over 18 years. His work ethic, deep local knowledge, and focus on finding the exact skill fit make him my first call for any open role.',
    title: 'HR Manager',
    company: 'Tier 1 Automotive Supplier',
  },
  {
  quote: "Aaron isn't just a recruiter; he's a trusted partner who truly understands manufacturing. He asks the right questions, communicates constantly, and presents candidates who fit both our skills and culture perfectly.",
  title: 'VP of Operations',
  company: 'Manufacturing Company',
  },
  {
    quote: 'NEED A 3RD ONE HERE.',
    name: 'Test name',
    title: 'Director of Test',
    company: 'GG Group',
  },
];

const clientLogos = ['Company Logo Here', 'Company Logo Here', 'Company Logo Here', 'Company Logo Here', 'Company Logo Here', 'Company Logo Here'];

const metaDescription = "Beacon Search Group recruits for manufacturers, engineering firms, and industrial operations nationwide, from skilled trades to executive leadership. Retained search, direct hire, and more.";
---

<Layout description={metaDescription}>
  <section class="relative w-full overflow-hidden bg-brand-accent">
    <img
      src="https://cdn.magicpatterns.com/patterns/generated-images/f2b14831-d44e-4040-a984-08ce782d5f22.jpg"
      alt="Advanced manufacturing floor with CNC machines lit by a sweeping beam of light"
      class="absolute inset-0 h-full w-full object-cover opacity-40"
      loading="eager"
      decoding="async"
    />
    <div aria-hidden="true" class="absolute inset-0 bg-brand-accent/80"></div>
    <div aria-hidden="true" class="absolute inset-y-0 left-0 hidden w-1/2 bg-brand-accent/45 md:block"></div>
    <div aria-hidden="true" class="absolute -left-24 top-0 hidden h-full w-24 rotate-12 bg-brand-primary/[0.07] md:block"></div>

    <div class="relative z-10 mx-auto w-full max-w-7xl px-5 pb-14 pt-16 sm:px-8 md:pb-20 md:pt-28">
      <div class="max-w-3xl transition-all duration-700 ease-out">
        <p class="flex items-center gap-3 font-sans text-[11px] font-semibold uppercase tracking-[0.22em] text-brand-primary">
          <span aria-hidden="true" class="inline-block h-px w-8 bg-brand-secondary"></span>
          Specialized Recruiting &amp; Executive Search
        </p>

        <h1 class="mt-6 font-serif text-[38px] font-bold leading-[1.08] tracking-tight text-white sm:text-5xl md:text-[62px]">
          Lighting the Way In{' '}
          <span class="relative inline-block text-brand-primary">Talent Innovation</span>
        </h1>

        <p class="mt-6 max-w-2xl font-sans text-lg leading-relaxed text-white/75">
          We place engineers, skilled tradespeople, and operations leaders with manufacturers
          and industrial companies. From a single hard-to-fill role to a full plant ramp-up.
          Decades of combined experience, and a network you cannot query from a database.
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 md:mt-14 md:max-w-4xl">
        {/* Card 1: Employer Path */}
        <div class="group relative flex flex-col justify-between overflow-hidden rounded-sm border border-brand-secondary/60 bg-brand-secondary/10 p-6 transition-colors duration-200 hover:bg-brand-secondary/20">
          <span
            aria-hidden="true"
            class="absolute left-0 top-0 h-full w-1 bg-brand-secondary"
          ></span>
          <div class="pl-3">
            <svg class="h-6 w-6 text-brand-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <h2 class="mt-4 font-serif text-2xl font-bold text-white">
              <a href="/contact" class="focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2 focus-visible:ring-offset-brand-accent after:absolute after:inset-0">
                I'm hiring
              </a>
            </h2>
            <p class="mt-2 font-sans text-sm leading-relaxed text-white/65">
              Tell us about the role. We will tell you what the market looks like and what it takes to fill it.
            </p>
          </div>
          <span class="mt-6 inline-flex items-center gap-2 pl-3 font-sans text-sm font-semibold text-brand-secondary">
            Start a search
            <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </div>

        {/* Card 2: Candidate Path */}
        <div class="group relative flex flex-col justify-between overflow-hidden rounded-sm border border-white/20 bg-white/6 p-6 transition-colors duration-200 hover:bg-white/12">
          <span
            aria-hidden="true"
            class="absolute left-0 top-0 h-full w-1 bg-brand-primary"
          ></span>
          <div class="pl-3">
            <svg class="h-6 w-6 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <h2 class="mt-4 font-serif text-2xl font-bold text-white">
              <a href="/careers" class="focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2 focus-visible:ring-offset-brand-accent after:absolute after:inset-0">
                I'm looking for a role
              </a>
            </h2>
            <p class="mt-2 font-sans text-sm leading-relaxed text-white/65">
              See open positions across manufacturing, engineering, skilled trades, and leadership.
            </p>
          </div>
          <span class="mt-6 inline-flex items-center gap-2 pl-3 font-sans text-sm font-semibold text-brand-primary">
            Browse open roles
            <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </div>
      </div>
    </div>
  </section>

    {/* ================= STATS BAR ================= */}
    <section aria-label="Beacon Search Group at a glance" class="w-full bg-brand-primary-soft">
      <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px overflow-hidden bg-brand-accent/10 sm:px-0 lg:grid-cols-4">
        {stats.map((stat: StatItem) => (
          <div class="bg-brand-primary-soft px-5 py-8 text-center sm:px-8">
            <p class="font-serif text-2xl font-bold text-brand-accent sm:text-3xl">
              {stat.number !== null ? (
                <span 
                  class="stat-counter" 
                  data-target={stat.number} 
                  data-suffix={stat.suffix}
                >
                  0{stat.suffix}
                </span>
              ) : (
                <span>{stat.value}</span>
              )}
            </p>
            <p class="mx-auto mt-2 max-w-[16rem] font-sans text-[13px] leading-snug text-brand-accent/60">
              {stat.label}
            </p>
          </div>
        ))}
      </div>
    </section>

    {/* ================= SERVICES OVERVIEW ================= */}
<section
  class="mx-auto max-w-7xl px-5 py-12 sm:px-8 md:py-20"
  aria-labelledby="services-heading"
>
  <SectionHeader
    eyebrow="Our Services"
    title="The right engagement for the role you're filling"
    description="From one retained executive search to a full contract workforce ramp-up, the engagement flexes to how you actually need to hire."
  />

  <div
    class="mt-10 lg:mt-12 lg:grid lg:grid-cols-12 lg:gap-8"
    id="services-tabs"
  >

    {/* =========================================================
        DESKTOP / TABLET SERVICE NAVIGATION
        ========================================================= */}
    <nav
      class="hidden lg:col-span-4 lg:flex lg:flex-col lg:border-r lg:border-brand-accent/10 lg:pr-6"
      aria-label="Services List"
    >
      {services.map((service, index) => (
        <button
          type="button"
          data-service-tab={service.slug}
          aria-selected={index === 0 ? "true" : "false"}
          class={`service-tab-btn group relative flex cursor-pointer items-center gap-4 border-b border-brand-accent/10 py-5 text-left transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary ${
            index === 0
              ? 'bg-brand-primary-soft/30'
              : 'hover:bg-brand-primary-soft/15'
          }`}
        >
          {/* Active indicator */}
          <span
            aria-hidden="true"
            class={`active-indicator absolute left-0 top-0 h-full w-1 bg-brand-primary transition-opacity duration-200 ${
              index === 0 ? 'opacity-100' : 'opacity-0'
            }`}
          ></span>

          {/* Number */}
          <span
            class={`service-number pl-4 font-serif text-2xl font-bold leading-none transition-colors duration-200 ${
              index === 0
                ? 'text-brand-primary'
                : 'text-brand-accent/20 group-hover:text-brand-primary/50'
            }`}
          >
            {String(index + 1).padStart(2, '0')}
          </span>

          {/* Service name */}
          <div class="min-w-0 flex-1 pr-3">
            <div class="flex items-center gap-2">
              <span class="font-sans text-[9px] font-semibold uppercase tracking-[0.15em] text-brand-secondary">
                {service.subtitle}
              </span>

              {service.badge && (
                <span class="bg-brand-secondary/20 px-1.5 py-0.5 font-sans text-[8px] font-bold uppercase tracking-wider text-brand-accent">
                  {service.badge}
                </span>
              )}
            </div>

            <h3
              class={`mt-1 font-serif text-base font-bold transition-colors duration-200 ${
                index === 0
                  ? 'text-brand-accent'
                  : 'text-brand-accent/75 group-hover:text-brand-accent'
              }`}
            >
              {service.name}
            </h3>
          </div>

          {/* Arrow */}
          <svg
            class={`mr-4 h-4 w-4 shrink-0 transition-all duration-200 ${
              index === 0
                ? 'translate-x-0 text-brand-primary opacity-100'
                : '-translate-x-1 text-brand-accent/20 opacity-0 group-hover:translate-x-0 group-hover:opacity-100'
            }`}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </button>
      ))}
    </nav>


    {/* =========================================================
        MOBILE SERVICE ACCORDION
        ========================================================= */}
    <div class="lg:hidden">
      <div class="border-t border-brand-accent/10">
        {services.map((service, index) => (
          <div
            class="mobile-service border-b border-brand-accent/10"
            data-mobile-service={service.slug}
          >
            {/* Accordion Header */}
            <button
              type="button"
              class="mobile-service-btn group flex w-full items-center gap-4 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
              data-mobile-service-btn={service.slug}
              aria-expanded={index === 0 ? "true" : "false"}
              aria-controls={`mobile-panel-${service.slug}`}
            >
              {/* Number */}
              <span
                class={`font-serif text-xl font-bold leading-none ${
                  index === 0
                    ? 'text-brand-primary'
                    : 'text-brand-accent/25'
                }`}
                data-mobile-number={service.slug}
              >
                {String(index + 1).padStart(2, '0')}
              </span>

              {/* Name */}
              <span class="min-w-0 flex-1">
                <span class="block font-sans text-[9px] font-semibold uppercase tracking-[0.15em] text-brand-secondary">
                  {service.subtitle}
                </span>

                <span class="mt-0.5 block font-serif text-lg font-bold text-brand-accent">
                  {service.name}
                </span>
              </span>

              {service.badge && (
                <span class="hidden bg-brand-secondary/20 px-2 py-1 font-sans text-[8px] font-bold uppercase tracking-wider text-brand-accent sm:inline-block">
                  {service.badge}
                </span>
              )}

              {/* Plus / Minus */}
              <span
                class="mobile-service-icon flex h-7 w-7 shrink-0 items-center justify-center border border-brand-accent/15 text-brand-accent transition-all duration-200"
                data-mobile-icon={service.slug}
                aria-hidden="true"
              >
                <svg
                  class={`h-3.5 w-3.5 ${
                    index === 0 ? 'hidden' : 'block'
                  }`}
                  data-plus-icon={service.slug}
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 5v14M5 12h14"
                  />
                </svg>

                <svg
                  class={`h-3.5 w-3.5 ${
                    index === 0 ? 'block' : 'hidden'
                  }`}
                  data-minus-icon={service.slug}
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 12h14"
                  />
                </svg>
              </span>
            </button>


            {/* Accordion Content */}
            <div
              id={`mobile-panel-${service.slug}`}
              class={`mobile-service-panel overflow-hidden transition-all duration-300 ${
                index === 0
                  ? 'max-h-[900px] opacity-100'
                  : 'max-h-0 opacity-0'
              }`}
              data-mobile-panel={service.slug}
            >
              <div class="pb-6">

                {/* Image */}
                <div class="relative aspect-[16/9] overflow-hidden border border-brand-accent/10">
                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    class="h-full w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />

                  {/* Subtle image overlay */}
                  <div
                    aria-hidden="true"
                    class="absolute inset-0 bg-brand-accent/10"
                  ></div>

                  {/* Number overlay */}
                  <span
                    aria-hidden="true"
                    class="absolute bottom-3 right-4 font-serif text-5xl font-bold leading-none text-white/20"
                  >
                    {String(index + 1).padStart(2, '0')}
                  </span>
                </div>

                {/* Content */}
                <div class="mt-5">
                  <p class="font-sans text-sm leading-relaxed text-brand-accent/75">
                    {service.whatItIs}
                  </p>

                  {/* Best Suited For */}
                  <div class="mt-5 border-t border-brand-accent/10 pt-4">
                    <p class="font-sans text-[9px] font-semibold uppercase tracking-[0.16em] text-brand-accent/45">
                      Best Suited For
                    </p>

                    <div class="mt-3 flex flex-wrap gap-2">
                      {service.bestFor.map((item) => (
