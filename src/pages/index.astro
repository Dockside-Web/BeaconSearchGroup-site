<style>
  /* Utility to hide scrollbars on mobile horizontal tab list */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  // 1. STAT COUNTERS
  function initCounters(): void {
    const counters = document.querySelectorAll<HTMLElement>(".stat-counter");
    if (!counters.length) return;

    const observer = new IntersectionObserver(
      (entries: IntersectionObserverEntry[], obs: IntersectionObserver) => {
        entries.forEach((entry: IntersectionObserverEntry) => {
          if (!entry.isIntersecting) return;

          const el = entry.target as HTMLElement;
          const target = parseInt(el.getAttribute("data-target") ?? "0", 10);
          const suffix = el.getAttribute("data-suffix") ?? "";
          const duration = 1000;
          const startTime = performance.now();

          function updateCount(currentTime: number): void {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const easeOutProgress = 1 - Math.pow(1 - progress, 2);
            const currentCount = Math.floor(easeOutProgress * target);

            el.textContent = `${currentCount}${suffix}`;

            if (progress < 1) {
              requestAnimationFrame(updateCount);
            } else {
              el.textContent = `${target}${suffix}`;
            }
          }

          requestAnimationFrame(updateCount);
          obs.unobserve(el);
        });
      },
      { threshold: 0.3 }
    );

    counters.forEach((counter: HTMLElement) => observer.observe(counter));
  }

  // 2. SERVICES TABS & ACCORDION
  function setupServiceTabs(): void {
    const container = document.getElementById("services-tabs");
    if (!container) return;

    /* Desktop Tabs */
    const tabs = container.querySelectorAll<HTMLButtonElement>("[data-service-tab]");
    const panels = container.querySelectorAll<HTMLElement>("[data-service-panel]");

    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        const targetSlug = tab.getAttribute("data-service-tab");
        if (!targetSlug) return;

        tabs.forEach(t => {
          const isSelected = t === tab;
          t.setAttribute("aria-selected", isSelected ? "true" : "false");

          const indicator = t.querySelector(".active-indicator");
          const number = t.querySelector(".service-number");
          const arrow = t.querySelector("svg");

          t.classList.toggle("bg-brand-primary-soft/30", isSelected);
          t.classList.toggle("hover:bg-brand-primary-soft/15", !isSelected);

          if (indicator) {
            indicator.classList.toggle("opacity-100", isSelected);
            indicator.classList.toggle("opacity-0", !isSelected);
          }

          if (number) {
            number.classList.toggle("text-brand-primary", isSelected);
            number.classList.toggle("text-brand-accent/20", !isSelected);
          }

          if (arrow) {
            arrow.classList.toggle("translate-x-0", isSelected);
            arrow.classList.toggle("-translate-x-1", !isSelected);
            arrow.classList.toggle("text-brand-primary", isSelected);
            arrow.classList.toggle("text-brand-accent/20", !isSelected);
            arrow.classList.toggle("opacity-100", isSelected);
            arrow.classList.toggle("opacity-0", !isSelected);
          }
        });

        panels.forEach(panel => {
          const isMatch = panel.getAttribute("data-service-panel") === targetSlug;

          if (isMatch) {
            panel.classList.remove("hidden");
            requestAnimationFrame(() => {
              panel.classList.remove("opacity-0");
              panel.classList.add("opacity-100");
            });
          } else {
            panel.classList.replace("opacity-100", "opacity-0");
            panel.classList.add("hidden");
          }
        });
      });
    });

    /* Mobile Accordion */
    const mobileButtons = container.querySelectorAll<HTMLButtonElement>("[data-mobile-service-btn]");

    const toggleAccordionState = (slug: string, isOpen: boolean) => {
      const panel = container.querySelector<HTMLElement>(`[data-mobile-panel="${slug}"]`);
      const plusIcon = container.querySelector<SVGElement>(`[data-plus-icon="${slug}"]`);
      const minusIcon = container.querySelector<SVGElement>(`[data-minus-icon="${slug}"]`);
      const number = container.querySelector<HTMLElement>(`[data-mobile-number="${slug}"]`);

      if (panel) {
        panel.classList.toggle("max-h-[900px]", isOpen);
        panel.classList.toggle("opacity-100", isOpen);
        panel.classList.toggle("max-h-0", !isOpen);
        panel.classList.toggle("opacity-0", !isOpen);
      }

      if (plusIcon) plusIcon.classList.toggle("hidden", isOpen);
      if (minusIcon) minusIcon.classList.toggle("hidden", !isOpen);

      if (number) {
        number.classList.toggle("text-brand-primary", isOpen);
        number.classList.toggle("text-brand-accent/25", !isOpen);
      }
    };

    mobileButtons.forEach(button => {
      button.addEventListener("click", () => {
        const targetSlug = button.getAttribute("data-mobile-service-btn");
        if (!targetSlug) return;

        const isCurrentlyOpen = button.getAttribute("aria-expanded") === "true";

        // Close all other accordions
        mobileButtons.forEach(otherBtn => {
          if (otherBtn !== button) {
            const otherSlug = otherBtn.getAttribute("data-mobile-service-btn");
            if (otherSlug) {
              otherBtn.setAttribute("aria-expanded", "false");
              toggleAccordionState(otherSlug, false);
            }
          }
        });

        // Toggle clicked item
        button.setAttribute("aria-expanded", isCurrentlyOpen ? "false" : "true");
        toggleAccordionState(targetSlug, !isCurrentlyOpen);
      });
    });
  }

  function setupAccordion() {
  const accordion = document.getElementById('industry-accordion');
  if (!accordion) return;

  const cards = accordion.querySelectorAll<HTMLButtonElement>('[data-accordion-card]');

  cards.forEach(card => {
    card.addEventListener('click', () => {
      // 1. Deactivate all cards
      cards.forEach(c => {
        c.classList.remove('is-active');
        c.setAttribute('aria-expanded', 'false');
      });

      // 2. Activate clicked card
      card.classList.add('is-active');
      card.setAttribute('aria-expanded', 'true');
    });
  });
}

  // 3. TESTIMONIALS WIDGET
  function setupTestimonialWidget(): void {
    const widget = document.getElementById("testimonial-widget");
    if (!widget) return;

    const buttons = widget.querySelectorAll<HTMLButtonElement>(".testimonial-tab-btn");
    const contents = widget.querySelectorAll<HTMLElement>("[data-testimonial-content]");

    buttons.forEach((btn, index) => {
      btn.addEventListener("click", () => {
        // Toggle button active variants
        buttons.forEach((b, i) => {
          const isSelected = i === index;

          if (isSelected) {
            b.classList.add("bg-brand-secondary", "text-white", "shadow-sm");
            b.classList.remove("border", "border-brand-accent/25", "text-brand-accent", "bg-white", "hover:border-brand-primary", "hover:text-brand-primary");
          } else {
            b.classList.remove("bg-brand-secondary", "text-white", "shadow-sm");
            b.classList.add("border", "border-brand-accent/25", "text-brand-accent", "bg-white", "hover:border-brand-primary", "hover:text-brand-primary");
          }
        });

        // Toggle panels
        contents.forEach((c, i) => {
          const isMatch = i === index;
          c.classList.toggle("block", isMatch);
          c.classList.toggle("opacity-100", isMatch);
          c.classList.toggle("hidden", !isMatch);
          c.classList.toggle("opacity-0", !isMatch);
        });
      });
    });
  }

  // BIND ALL INITIALIZERS
  function initAll(): void {
    initCounters();
    setupServiceTabs();
    setupTestimonialWidget();
  }

  setupAccordion();
  document.addEventListener('astro:page-load', setupAccordion);

  document.addEventListener("DOMContentLoaded", initAll);
  document.addEventListener("astro:page-load", initAll);
</script>
