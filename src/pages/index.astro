<style>
  /* Utility to hide scrollbars on mobile horizontal tab list */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>


<script>
  function initCounters(): void {
    const counters = document.querySelectorAll<HTMLElement>('.stat-counter');
    if (!counters.length) return;

    const observer = new IntersectionObserver((entries: IntersectionObserverEntry[], obs: IntersectionObserver) => {
      entries.forEach((entry: IntersectionObserverEntry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const target = parseInt(el.getAttribute('data-target') ?? '0', 10);
          const suffix = el.getAttribute('data-suffix') ?? '';
          const duration = 1000;
          const startTime = performance.now();

          function updateCount(currentTime: number): void {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            
            const easeOutProgress = 1 - Math.pow(1 - progress, 2);
            const currentCount = Math.floor(easeOutProgress * target);

            el.textContent = `${currentCount}${suffix}`;

            if (progress < 1) {
              requestAnimationFrame(updateCount);
            } else {
              el.textContent = `${target}${suffix}`;
            }
          }

          requestAnimationFrame(updateCount);
          obs.unobserve(el);
        }
      });
    }, { threshold: 0.3 });

    counters.forEach((counter: HTMLElement) => observer.observe(counter));
  }

  document.addEventListener('DOMContentLoaded', initCounters);
  document.addEventListener('astro:page-load', initCounters);

  function setupServiceTabs(): void {
  const container = document.getElementById('services-tabs');
  if (!container) return;

  /* =========================================================
     DESKTOP TABS
     ========================================================= */
  const tabs = container.querySelectorAll<HTMLButtonElement>(
    '[data-service-tab]'
  );

  const panels = container.querySelectorAll<HTMLElement>(
    '[data-service-panel]'
  );

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetSlug = tab.getAttribute('data-service-tab');
      if (!targetSlug) return;

      /* Update desktop navigation */
      tabs.forEach((t) => {
        const isSelected = t === tab;

        t.setAttribute(
          'aria-selected',
          isSelected ? 'true' : 'false'
        );

        const indicator = t.querySelector('.active-indicator');
        const number = t.querySelector('.service-number');
        const arrow = t.querySelector('svg');

        if (isSelected) {
          t.classList.add(
            'bg-brand-primary-soft/30'
          );

          t.classList.remove(
            'hover:bg-brand-primary-soft/15'
          );

          if (indicator) {
            indicator.classList.replace(
              'opacity-0',
              'opacity-100'
            );
          }

          if (number) {
            number.classList.remove(
              'text-brand-accent/20'
            );

            number.classList.add(
              'text-brand-primary'
            );
          }

          if (arrow) {
            arrow.classList.remove(
              '-translate-x-1',
              'text-brand-accent/20',
              'opacity-0'
            );

            arrow.classList.add(
              'translate-x-0',
              'text-brand-primary',
              'opacity-100'
            );
          }
        } else {
          t.classList.remove(
            'bg-brand-primary-soft/30'
          );

          t.classList.add(
            'hover:bg-brand-primary-soft/15'
          );

          if (indicator) {
            indicator.classList.replace(
              'opacity-100',
              'opacity-0'
            );
          }

          if (number) {
            number.classList.remove(
              'text-brand-primary'
            );

            number.classList.add(
              'text-brand-accent/20'
            );
          }

          if (arrow) {
            arrow.classList.remove(
              'translate-x-0',
              'text-brand-primary',
              'opacity-100'
            );

            arrow.classList.add(
              '-translate-x-1',
              'text-brand-accent/20',
              'opacity-0'
            );
          }
        }
      });


      /* Update desktop panels */
      panels.forEach((panel) => {
        const isMatch =
          panel.getAttribute('data-service-panel') === targetSlug;

        if (isMatch) {
          panel.classList.remove('hidden');

          requestAnimationFrame(() => {
            panel.classList.remove('opacity-0');
            panel.classList.add('opacity-100');
          });
        } else {
          panel.classList.add('opacity-0');
          panel.classList.remove('opacity-100');
          panel.classList.add('hidden');
        }
      });
    });
  });


  /* =========================================================
     MOBILE ACCORDION
     ========================================================= */
  const mobileButtons =
    container.querySelectorAll<HTMLButtonElement>(
      '[data-mobile-service-btn]'
    );

  const mobilePanels =
    container.querySelectorAll<HTMLElement>(
      '[data-mobile-panel]'
    );

  mobileButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const targetSlug =
        button.getAttribute('data-mobile-service-btn');

      if (!targetSlug) return;

      const panel = container.querySelector<HTMLElement>(
        `[data-mobile-panel="${targetSlug}"]`
      );

      const isCurrentlyOpen =
        button.getAttribute('aria-expanded') === 'true';


      /* Close every other accordion */
      mobileButtons.forEach((otherButton) => {
        const otherSlug =
          otherButton.getAttribute(
            'data-mobile-service-btn'
          );

        const otherPanel = container.querySelector<HTMLElement>(
          `[data-mobile-panel="${otherSlug}"]`
        );

        const plusIcon =
          container.querySelector<SVGElement>(
            `[data-plus-icon="${otherSlug}"]`
          );

        const minusIcon =
          container.querySelector<SVGElement>(
            `[data-minus-icon="${otherSlug}"]`
          );

        const number =
          container.querySelector<HTMLElement>(
            `[data-mobile-number="${otherSlug}"]`
          );

        if (otherButton !== button) {
          otherButton.setAttribute(
            'aria-expanded',
            'false'
          );

          if (otherPanel) {
            otherPanel.classList.remove(
              'max-h-[900px]',
              'opacity-100'
            );

            otherPanel.classList.add(
              'max-h-0',
              'opacity-0'
            );
          }

          if (plusIcon) {
            plusIcon.classList.remove('hidden');
            plusIcon.classList.add('block');
          }

          if (minusIcon) {
            minusIcon.classList.remove('block');
            minusIcon.classList.add('hidden');
          }

          if (number) {
            number.classList.remove(
              'text-brand-primary'
            );

            number.classList.add(
              'text-brand-accent/25'
            );
          }
        }
      });


      /* Toggle clicked accordion */
      if (isCurrentlyOpen) {
        button.setAttribute(
          'aria-expanded',
          'false'
        );

        if (panel) {
          panel.classList.remove(
            'max-h-[900px]',
            'opacity-100'
          );

          panel.classList.add(
            'max-h-0',
            'opacity-0'
          );
        }

        const plusIcon =
          container.querySelector<SVGElement>(
            `[data-plus-icon="${targetSlug}"]`
          );

        const minusIcon =
          container.querySelector<SVGElement>(
            `[data-minus-icon="${targetSlug}"]`
          );

        const number =
          container.querySelector<HTMLElement>(
            `[data-mobile-number="${targetSlug}"]`
          );

        if (plusIcon) {
          plusIcon.classList.remove('hidden');
          plusIcon.classList.add('block');
        }

        if (minusIcon) {
          minusIcon.classList.remove('block');
          minusIcon.classList.add('hidden');
        }

        if (number) {
          number.classList.remove(
            'text-brand-primary'
          );

          number.classList.add(
            'text-brand-accent/25'
          );
        }

      } else {
        button.setAttribute(
          'aria-expanded',
          'true'
        );

        if (panel) {
          panel.classList.remove(
            'max-h-0',
            'opacity-0'
          );

          panel.classList.add(
            'max-h-[900px]',
            'opacity-100'
          );
        }

        const plusIcon =
          container.querySelector<SVGElement>(
            `[data-plus-icon="${targetSlug}"]`
          );

        const minusIcon =
          container.querySelector<SVGElement>(
            `[data-minus-icon="${targetSlug}"]`
          );

        const number =
          container.querySelector<HTMLElement>(
            `[data-mobile-number="${targetSlug}"]`
          );

        if (plusIcon) {
          plusIcon.classList.remove('block');
          plusIcon.classList.add('hidden');
        }

        if (minusIcon) {
          minusIcon.classList.remove('hidden');
          minusIcon.classList.add('block');
        }

        if (number) {
          number.classList.remove(
            'text-brand-accent/25'
          );

          number.classList.add(
            'text-brand-primary'
          );
        }
      }
    });
  });
}

  document.addEventListener('DOMContentLoaded', setupServiceTabs);
  document.addEventListener('astro:page-load', setupServiceTabs);
</script>