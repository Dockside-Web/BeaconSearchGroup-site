---
import Layout from "../layouts/Layout.astro";
import Button from '../components/Button.astro';
import CTASection from '../components/CTA.astro';

const stats = [
  { value: 'Decades', label: 'Of combined recruiting experience' },
  { value: '8', label: 'Technical & professional disciplines' },
  { value: '1 – 100+', label: 'Hires per engagement, any volume' },
  { value: 'Nationwide', label: 'Search reach across U.S. industry' },
];

const services = [
  {
    name: 'Direct Hire Search',
    slug: 'direct-hire',
    tagline: 'Permanent placements for critical engineering, technical, and operational leadership roles.',
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/8eeabe6d-c66a-4049-b5a4-afc43f76dbe9.jpg',
    imageAlt: 'Engineering team reviewing blueprints',
  },
  {
    name: 'Executive Search',
    slug: 'executive-search',
    tagline: 'Retained search for C-suite, VP, and Director-level industrial leadership.',
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/5526439e-9324-41e1-8079-0e0f553fad6f.jpg',
    imageAlt: 'Executive meeting room',
  },
  {
    name: 'Contract & Staffing',
    slug: 'contract-staffing',
    tagline: 'Flexible technical talent for plant expansions, project ramps, and turnarounds.',
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/787727ef-fe41-4eea-9e31-12282675c434.jpg',
    imageAlt: 'Technician operating machinery',
  },
  {
    name: 'RPO & Volume Hiring',
    slug: 'rpo-volume',
    tagline: 'Embedded recruitment solutions to scale entire technical departments quickly.',
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/f2b14831-d44e-4040-a984-08ce782d5f22.jpg',
    imageAlt: 'Manufacturing plant floor',
  },
];

const industries = [
  {
    name: 'Advanced Manufacturing',
    description: 'Automation, robotics, CNC machining, and high-precision assembly operations.',
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/f2b14831-d44e-4040-a984-08ce782d5f22.jpg',
    imageAlt: 'Advanced manufacturing floor',
    roles: ['Automation Engineer', 'Plant Manager', 'Controls Specialist'],
  },
  {
    name: 'Automotive & Mobility',
    description: 'Tier-1 suppliers, EV manufacturing, assembly, and powertrain components.',
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/8eeabe6d-c66a-4049-b5a4-afc43f76dbe9.jpg',
    imageAlt: 'Automotive production facility',
    roles: ['Quality Manager', 'Process Engineer', 'Tooling Technician'],
  },
  {
    name: 'Aerospace & Defense',
    description: 'Precision machining, AS9100 quality standards, composites, and defense systems.',
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/787727ef-fe41-4eea-9e31-12282675c434.jpg',
    imageAlt: 'Aerospace manufacturing component',
    roles: ['Quality Assurance Lead', 'Manufacturing Engineer', 'EHS Director'],
  },
  {
    name: 'Heavy Industrial',
    description: 'Steel, metals, chemical processing, packaging, and heavy machinery production.',
    image: 'https://cdn.magicpatterns.com/patterns/generated-images/5526439e-9324-41e1-8079-0e0f553fad6f.jpg',
    imageAlt: 'Heavy industrial plant floor',
    roles: ['Maintenance Manager', 'Electrical Technician', 'Operations VP'],
  },
];

const differentiators = [
  {
    title: 'A network, not a database',
    body: 'The people we place are usually not applying to anything. They are known to us — from years of working the same plants, the same conferences, and the same technical communities.',
  },
  {
    title: 'Consultative from the first call',
    body: 'We will tell you if the comp is off, if the title is wrong, or if the search will take longer than you hope. Honest market feedback beats a stack of resumes.',
  },
  {
    title: 'Industry depth, not generalists',
    body: 'Manufacturing, engineering, skilled trades, supply chain, quality, EHS, HR, and professional operations. That is the whole list, and it is deliberately short.',
  },
  {
    title: 'Any size, any volume',
    body: 'One retained executive search or fifty contract technicians for a launch. Growing manufacturers and Fortune 500 operations get the same senior attention.',
  },
];

const testimonials = [
  {
    quote:
      'Aaron has been my go-to recruiting partner for over 18 years. His work ethic, deep local knowledge, and focus on finding the exact skill fit make him my first call for any open role.',
    title: 'HR Manager',
    company: 'Tier 1 Automotive Supplier',
  },
  {
  quote: "Aaron isn't just a recruiter; he's a trusted partner who truly understands manufacturing. He asks the right questions, communicates constantly, and presents candidates who fit both our skills and culture perfectly.",
  title: 'VP of Operations',
  company: 'Manufacturing Company',
  },
  {
    quote: 'NEED A 3RD ONE HERE.',
    name: 'Test name',
    title: 'Director of Test',
    company: 'GG Group',
  },
];

const clientLogos = ['Company Logo Here', 'Company Logo Here', 'Company Logo Here', 'Company Logo Here', 'Company Logo Here', 'Company Logo Here'];

const paths = [
  {
    to: '/contact',
    label: "I'm hiring",
    description: 'Tell us about the role. We will tell you what the market looks like and what it takes to fill it.',
    action: 'Start a search',
    accent: 'secondary',
  },
  {
    to: '/careers',
    label: "I'm looking for a role",
    description: 'See open positions across manufacturing, engineering, skilled trades, and leadership.',
    action: 'Browse open roles',
    accent: 'primary',
  },
];


const metaDescription = "Beacon Search Group recruits for manufacturers, engineering firms, and industrial operations nationwide, from skilled trades to executive leadership. Retained search, direct hire, and more.";
---

<Layout description={metaDescription}>
  <section class="relative w-full overflow-hidden bg-brand-accent">
      <img
        src="https://cdn.magicpatterns.com/patterns/generated-images/f2b14831-d44e-4040-a984-08ce782d5f22.jpg"
        alt="Advanced manufacturing floor with CNC machines lit by a sweeping beam of light"
        class="absolute inset-0 h-full w-full object-cover opacity-40"
        loading="eager"
        decoding="async"
      />
      <div aria-hidden="true" class="absolute inset-0 bg-brand-accent/80"></div>
      <div aria-hidden="true" class="absolute inset-y-0 left-0 hidden w-1/2 bg-brand-accent/45 md:block"></div>
      <div aria-hidden="true" class="absolute -left-24 top-0 hidden h-full w-24 rotate-12 bg-brand-primary/[0.07] md:block"></div>

      <div class="relative mx-auto w-full max-w-7xl px-5 pb-14 pt-16 sm:px-8 md:pb-20 md:pt-28">
        <div class="max-w-3xl transition-all duration-700 ease-out">
          <p class="flex items-center gap-3 font-sans text-[11px] font-semibold uppercase tracking-[0.22em] text-brand-primary">
            <span aria-hidden="true" class="inline-block h-px w-8 bg-brand-secondary"></span>
            Specialized Recruiting &amp; Executive Search
          </p>

          <h1 class="mt-6 font-serif text-[38px] font-bold leading-[1.08] tracking-tight text-white sm:text-5xl md:text-[62px]">
            Lighting the Way In{' '}
            <span class="relative inline-block text-brand-primary">Talent Innovation</span>
          </h1>

          <p class="mt-6 max-w-2xl font-sans text-lg leading-relaxed text-white/75">
            We place engineers, skilled tradespeople, and operations leaders with manufacturers
            and industrial companies. From a single hard-to-fill role to a full plant ramp-up.
            Decades of combined experience, and a network you cannot query from a database.
          </p>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2 md:mt-14 md:max-w-4xl">
          {paths.map((path) => {
            const isSecondary = path.accent === 'secondary';
            return (
              <a
                href={path.to}
                class={`group relative flex flex-col justify-between overflow-hidden rounded-sm border p-6 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2 focus-visible:ring-offset-brand-accent ${
                  isSecondary
                    ? 'border-brand-secondary/60 bg-brand-secondary/10 hover:bg-brand-secondary/20'
                    : 'border-white/20 bg-white/6 hover:bg-white/12'
                }`}
              >
                <span
                  aria-hidden="true"
                  class={`absolute left-0 top-0 h-full w-1 ${
                    isSecondary ? 'bg-brand-secondary' : 'bg-brand-primary'
                  }`}
                />
                <div class="pl-3">
                  {/* Users Icon / Briefcase Icon */}
                  {isSecondary ? (
                    <svg class="h-6 w-6 text-brand-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                  ) : (
                    <svg class="h-6 w-6 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  )}
                  <h2 class="mt-4 font-serif text-2xl font-bold text-white">{path.label}</h2>
                  <p class="mt-2 font-sans text-sm leading-relaxed text-white/65">
                    {path.description}
                  </p>
                </div>
                <span
                  class={`mt-6 inline-flex items-center gap-2 pl-3 font-sans text-sm font-semibold ${
                    isSecondary ? 'text-brand-secondary' : 'text-brand-primary'
                  }`}
                >
                  {path.action}
                  <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    {/* ================= STATS BAR ================= */}
    <section aria-label="Beacon Search Group at a glance" class="w-full bg-brand-primary-soft">
      <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px overflow-hidden bg-brand-accent/10 sm:px-0 lg:grid-cols-4">
        {stats.map((stat) => (
          <div class="bg-brand-primary-soft px-5 py-8 text-center sm:px-8">
            <p class="font-serif text-2xl font-bold text-brand-accent sm:text-3xl">
              {stat.value}
            </p>
            <p class="mx-auto mt-2 max-w-[16rem] font-sans text-[13px] leading-snug text-brand-accent/60">
              {stat.label}
            </p>
          </div>
        ))}
      </div>
    </section>

    {/* ================= SERVICES OVERVIEW ================= */}
    <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 md:py-24" aria-labelledby="services-heading">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-secondary">What We Do</p>
          <h2 id="services-heading" class="mt-2 font-serif text-3xl font-bold text-brand-accent sm:text-4xl">Four ways to work with us</h2>
          <p class="mt-4 max-w-2xl font-sans text-base leading-relaxed text-brand-accent/70">
            Whether you need one senior engineer or a full second shift, the engagement flexes to the problem — not the other way around.
          </p>
        </div>
        <Button href="/services" variant="outline" size="md">
          All Services
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </Button>
      </div>

      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((service, index) => (
          <li class="group relative flex flex-col border border-brand-accent/10 bg-white">
            <div class="relative aspect-3/2 overflow-hidden">
              <img
                src={service.image}
                alt={service.imageAlt}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <span
                aria-hidden="true"
                class="absolute left-0 top-0 flex h-9 w-9 items-center justify-center bg-brand-accent font-sans text-[13px] font-bold text-brand-primary"
              >
                {`0${index + 1}`}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="font-serif text-xl font-bold text-brand-accent">
                <a
                  href={`/services#${service.slug}`}
                  class="after:absolute after:inset-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
                >
                  {service.name}
                </a>
              </h3>
              <p class="mt-3 flex-1 font-sans text-sm leading-relaxed text-brand-accent/65">
                {service.tagline}
              </p>
              <span class="mt-6 inline-flex items-center gap-2 font-sans text-sm font-semibold text-brand-secondary">
                Learn more
                <svg
                  class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
                  fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    {/* ================= INDUSTRIES SECTION ================= */}
    <section class="beacon-sweep relative overflow-hidden bg-brand-accent py-16 text-white md:py-24" aria-labelledby="industries-heading">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -left-40 top-1/2 h-150 w-150 -translate-y-1/2 rounded-full border border-white/5"
      ></div>
      <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
        <div>
          <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-primary">Industries We Serve</p>
          <h2 id="industries-heading" class="mt-2 font-serif text-3xl font-bold text-white sm:text-4xl">We know these markets because we only work in them</h2>
          <p class="mt-4 max-w-2xl font-sans text-base leading-relaxed text-white/70">
            Specialization is the whole point. Our recruiters speak the language of the plant floor, the design review, and the executive team — which is why the candidates we present are actually qualified.
          </p>
        </div>

        <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {industries.map((industry) => (
            <li class="group flex flex-col border border-white/10 bg-brand-accent-soft transition-all duration-300">
              <div class="relative aspect-4/3 overflow-hidden">
                <img
                  src={industry.image}
                  alt={industry.imageAlt}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
                <span
                  aria-hidden="true"
                  class="absolute inset-0 bg-brand-accent/25 transition-opacity duration-300 group-hover:opacity-0"
                />
                <span
                  aria-hidden="true"
                  class="absolute bottom-0 left-0 h-1 w-12 bg-brand-secondary transition-all duration-300 group-hover:w-full"
                />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="font-serif text-xl font-bold text-white">{industry.name}</h3>
                <p class="mt-3 flex-1 font-sans text-sm leading-relaxed text-white/60">
                  {industry.description}
                </p>
                <ul class="mt-5 space-y-1.5 border-t border-white/10 pt-4">
                  {industry.roles.map((role) => (
                    <li class="font-sans text-[13px] text-brand-primary">
                      {role}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ================= WHY BEACON ================= */}
    <section class="bg-brand-primary-soft/50 py-16 md:py-24" aria-labelledby="why-heading">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <div class="relative order-2 lg:order-1">
            <div
              aria-hidden="true"
              class="absolute -left-4 -top-4 hidden h-24 w-24 border-l-2 border-t-2 border-brand-secondary sm:block"
            ></div>
            <img
              src="https://cdn.magicpatterns.com/patterns/generated-images/8eeabe6d-c66a-4049-b5a4-afc43f76dbe9.jpg"
              alt="Two professionals reviewing plans on a tablet overlooking a production floor"
              class="relative w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="mt-4 grid grid-cols-2 gap-4">
              <img
                src="https://cdn.magicpatterns.com/patterns/generated-images/5526439e-9324-41e1-8079-0e0f553fad6f.jpg"
                alt="Maintenance technician servicing an industrial electrical panel"
                class="aspect-4/3 w-full object-cover"
                loading="lazy"
                decoding="async"
              />
              <img
                src="https://cdn.magicpatterns.com/patterns/generated-images/787727ef-fe41-4eea-9e31-12282675c434.jpg"
                alt="Engineer reviewing a 3D CAD assembly on a monitor"
                class="aspect-4/3 w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <div class="order-1 lg:order-2">
            <div>
              <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-secondary">Why Beacon</p>
              <h2 id="why-heading" class="mt-2 font-serif text-3xl font-bold text-brand-accent sm:text-4xl">Hiring in this market is hard. That is exactly the job.</h2>
              <p class="mt-4 max-w-2xl font-sans text-base leading-relaxed text-brand-accent/70">
                Technical talent is scarce, candidates are cautious, and job boards return the same forty resumes to everyone. We work the way recruiting worked before it got automated: by knowing people.
              </p>
            </div>

            <ul class="mt-10 space-y-6">
              {differentiators.map((item) => (
                <li class="flex gap-4">
                  <span
                    aria-hidden="true"
                    class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-primary"
                  >
                    <svg class="h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  <div>
                    <h3 class="font-serif text-lg font-bold text-brand-accent">{item.title}</h3>
                    <p class="mt-1.5 font-sans text-sm leading-relaxed text-brand-accent/70">
                      {item.body}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
            <div class="mt-10 flex flex-wrap gap-4">
  <Button href="/contact" variant="primary" size="md">
    Schedule a Consultation
  </Button>
  <Button href="/about" variant="outline" size="md">
    Our Search Process
  </Button>
</div>
          </div>
        </div>
      </div>
    </section>

    {/* ================= SOCIAL PROOF ================= */}
    <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 md:py-24" aria-labelledby="proof-heading">
      <div class="text-center">
        <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-secondary">Client Feedback</p>
        <h2 id="proof-heading" class="mt-2 font-serif text-3xl font-bold text-brand-accent sm:text-4xl">What our clients say</h2>
        <p class="mx-auto mt-4 max-w-2xl font-sans text-base leading-relaxed text-brand-accent/70">
          From growing manufacturers to Fortune 500 operations, the measure of a search partner is whether people call them back for the next role.
        </p>
      </div>

      <ul class="mt-12 grid gap-6 md:grid-cols-3">
  {testimonials.map((testimonial) => (
    <li class="flex flex-col border border-brand-accent/10 bg-white p-7 transition-colors duration-200 hover:border-brand-primary/50">
      <svg
        class="h-6 w-6 text-brand-primary"
        fill="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
      </svg>
      <blockquote class="mt-5 flex-1">
        <p class="font-serif text-[17px] leading-relaxed text-brand-accent/85">
          “{testimonial.quote}”
        </p>
      </blockquote>
      <footer class="mt-6 flex items-center gap-4 border-t border-brand-accent/10 pt-5">
        {/* Replaced initial text circle with a subtle Building/Company SVG Icon */}
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-primary-soft text-brand-primary-dark"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </span>
        <div>
          <p class="font-sans text-sm font-semibold text-brand-accent">
            {testimonial.title}
          </p>
          <p class="mt-0.5 font-sans text-[13px] text-brand-accent/55">
            {testimonial.company}
          </p>
        </div>
      </footer>
    </li>
  ))}
</ul>

      <div class="mt-14 border border-brand-accent/10 bg-brand-primary-soft px-6 py-10">
        <div class="flex items-center justify-center gap-3">
          {/* BeaconMark SVG */}
          <svg class="h-6 w-6 text-brand-accent" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2L2 22h20L12 2zm0 3.5L18.5 20H5.5L12 5.5z"/>
          </svg>
          <p class="font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-accent/45">
            Trusted by industrial and manufacturing teams nationwide
          </p>
        </div>
        <ul class="mx-auto mt-8 grid max-w-4xl grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
          {clientLogos.map((logo) => (
            <li class="flex h-16 items-center justify-center border border-brand-accent/10 bg-white font-sans text-[10px] font-semibold uppercase tracking-[0.15em] text-brand-accent/30">
              {logo}
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ================= CTA SECTION ================= */}
    <CTASection />

</Layout>
