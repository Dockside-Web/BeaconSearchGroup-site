---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTA.astro";

import aaronPhoto from "../assets/headshot-aaron.webp";
import alexPhoto from "../assets/headshot-alex.webp";

const leaders = [
  {
    name: "Aaron Laird",
    credentials: "CSP",
    title: "Managing Partner & Co-Founder",
    image: aaronPhoto,
    imageAlt:
      "Portrait of Aaron Laird, Managing Partner & Co-Founder of Beacon Search Group",
    bio: "Aaron brings 17+ years of recruiting experience in manufacturing, engineering, and skilled trades. Known for his integrity and consultative approach, he has built lasting relationships with clients and candidates nationwide. Outside of work, he is a WWII memorabilia collector who loves time on the water with family.",
    links: [
      {
        type: "email",
        href: "mailto:Alaird@BeaconSearchGroup.com",
      },
      {
        type: "linkedin",
        href: "https://www.linkedin.com/in/aaron-laird-csp-35a6551b/",
      },
    ],
  },
  {
    name: "Alex Gundy",
    title: "Managing Partner & Co-Founder",
    image: alexPhoto,
    imageAlt:
      "Portrait of Alex Gundy, Managing Partner & Co-Founder of Beacon Search Group",
    bio: "Alex has 12+ years of technical recruiting experience across manufacturing, engineering, and construction. An MBA graduate of Bowling Green State University, he is known for his reliability and deep industry relationships. Outside of work, he enjoys family time, sports, and classic rock.",
    links: [
      {
        type: "email",
        href: "mailto:Agundy@BeaconSearchGroup.com",
      },
      {
        type: "linkedin",
        href: "https://www.linkedin.com/in/alexgundy/",
      },
    ],
  },
];

const affiliations = [
  {
    name: "Bowling Green Chamber of Commerce",
    href: "https://www.bgchamber.net/",
  },
  {
    name: "NOHRA",
    href: "https://toledoshrm.org/",
  },
  {
    name: "Toledo Regional Chamber",
    href: "https://www.bbb.org/us/oh/toledo/profile/chamber-of-commerce/toledo-regional-chamber-of-commerce-0422-6958",
  },
];
---

<Layout
  title="Leadership"
  description="Meet the co-founders behind Beacon Search Group and learn more about the experience, values, and relationships behind the firm."
>
  <section class="bg-brand-accent">
    <div class="mx-auto w-full max-w-7xl px-5 py-16 sm:px-8 md:py-20">

      <p class="flex items-center gap-3 font-sans text-[11px] font-semibold uppercase tracking-[0.22em] text-brand-secondary">
        <span
          aria-hidden="true"
          class="inline-block h-px w-8 bg-brand-secondary"
        ></span>
        Leadership Team
      </p>

      <h1 class="mt-5 max-w-3xl font-serif text-[34px] font-bold leading-[1.1] tracking-tight text-white sm:text-5xl">
        Built on Experience.
        <br class="hidden sm:block" />
        Founded on Trust.
      </h1>

      <p class="mt-4 max-w-2xl font-serif text-xl font-semibold italic text-brand-primary sm:text-2xl">
        Driven to Do Recruiting Better.
      </p>

      <p class="mt-5 max-w-2xl font-sans text-base leading-relaxed text-white/70 sm:text-lg">
        Meet the co-founders behind Beacon Search Group — decades of combined
        recruiting experience, one shared commitment to doing right by clients
        and candidates alike.
      </p>

    </div>
  </section>


  <!-- =========================================================
       LEADERS
       ========================================================= -->
  <section class="bg-brand-primary-soft/20 py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-6">

      <div class="max-w-2xl">
        <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-secondary">
          Meet the Founders
        </p>

        <h2 class="mt-2 font-serif text-3xl font-bold tracking-tight text-brand-accent sm:text-4xl">
          Experience you can build a relationship with.
        </h2>

        <p class="mt-4 font-sans text-base leading-relaxed text-brand-accent/65">
          Beacon was built around a simple idea: recruiting works better when
          experienced people stay close to the process.
        </p>
      </div>


      <div class="mt-12 grid gap-8 lg:grid-cols-2">

        {leaders.map((leader) => (
          <article class="overflow-hidden border border-brand-accent/10 bg-white">

            <!-- Photo -->
            <div class="relative aspect-5/4 overflow-hidden bg-brand-primary-soft">
              <Image
                src={leader.image}
                alt={leader.imageAlt}
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />

              <div class="absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-brand-accent/40 to-transparent"></div>
            </div>


            <!-- Content -->
            <div class="p-7 sm:p-8">

              <h3 class="font-serif text-2xl font-bold text-brand-accent sm:text-3xl">
                {leader.name}

                {leader.credentials && (
                  <span class="ml-1 font-sans text-base font-semibold text-brand-accent/45">
                    , {leader.credentials}
                  </span>
                )}
              </h3>

              <p class="mt-1 font-sans text-[11px] font-semibold uppercase tracking-[0.16em] text-brand-secondary">
                {leader.title}
              </p>

              <div class="mt-5 h-px w-10 bg-brand-secondary"></div>

              <p class="mt-5 font-sans text-sm leading-relaxed text-brand-accent/70">
                {leader.bio}
              </p>


              <!-- Contact Links -->
              <div class="mt-6 flex items-center gap-2">

                {leader.links.map((link) => (
                  <a
                    href={link.href}
                    target={link.type === "linkedin" ? "_blank" : undefined}
                    rel={
                      link.type === "linkedin"
                        ? "noopener noreferrer"
                        : undefined
                    }
                    aria-label={
                      link.type === "email"
                        ? `Email ${leader.name}`
                        : `${leader.name} on LinkedIn`
                    }
                    class="flex h-9 w-9 items-center justify-center border border-brand-accent/15 text-brand-accent/55 transition-all duration-200 hover:border-brand-primary hover:bg-brand-primary hover:text-white"
                  >

                    {link.type === "email" ? (
                      <svg
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M3 8l7.89 5.26a2.5 2.5 0 002.22 0L21 8"
                        />
                        <rect
                          width="18"
                          height="14"
                          x="3"
                          y="5"
                          rx="2"
                        />
                      </svg>
                    ) : (
                      <svg
                        class="h-4 w-4"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 11.001-4.124 2.062 2.062 0 01-.001-4.124 2.062 2.062 0 01-.001 4.124zM7.114 20.452H3.558V9h3.556v11.452z" />
                      </svg>
                    )}

                  </a>
                ))}

              </div>

            </div>

          </article>
        ))}

      </div>

    </div>
  </section>


  <!-- =========================================================
       OUR STORY
       ========================================================= -->
  <section class="bg-brand-primary-soft/20 py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-6">

      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">

        <!-- Heading -->
        <div class="lg:col-span-4">
          <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-secondary">
            Our Story
          </p>

          <h2 class="mt-2 font-serif text-3xl font-bold tracking-tight text-brand-accent sm:text-4xl">
            Built with purpose.
          </h2>
        </div>


        <!-- Story -->
        <div class="lg:col-span-8">

          <div class="space-y-5 font-sans text-base leading-relaxed text-brand-accent/70">

            <p>
              Beacon Search Group was created from a shared vision at a pivotal
              point in our careers. The name Beacon represents what we strive to
              be every day: a trusted guide, a reliable partner, and a source
              of clarity in an often complex hiring landscape.
            </p>

            <p>
              We founded Beacon Search Group with one simple goal: to build the
              kind of recruiting firm we always wanted to work with — one rooted
              in integrity, accountability, transparency, and genuine
              relationships. A firm where clients are viewed as long-term
              partners and candidates are treated with respect.
            </p>

          </div>


          <!-- Affiliations -->
          <div class="mt-9 border-t border-brand-accent/10 pt-7">

            <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-accent/40">
              Proud Members Of
            </p>

            <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-3">

              {affiliations.map((org) => (
                <li>
                  <a
                    href={org.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-sans text-sm font-semibold text-brand-secondary underline decoration-brand-secondary/30 underline-offset-4 transition-colors duration-200 hover:text-brand-primary-dark"
                  >
                    {org.name}
                  </a>
                </li>
              ))}

            </ul>

          </div>

        </div>

      </div>

    </div>
  </section>

  <CTASection />

</Layout>