---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import CTASection from "../../components/CTA.astro";
import { contactInfo } from "../../data/site";

const lastUpdatedDate = "August 31, 2026";

const pageTitle = "Privacy Policy";
const metaDescription =
  "Read the " +
  contactInfo.businessName +
  " Privacy Policy to learn how we collect, use, and protect your data.";
---

<Layout title={pageTitle} description={metaDescription}>
  <PageHero eyebrow="Legal" title="Privacy Policy" intro={contactInfo.businessNameLegal} />

  <section class="bg-brand-primary-soft/20 py-20 sm:py-24">
    <div class="mx-auto max-w-4xl px-6">
      <div class="border border-brand-accent/10 bg-white">
        <div class="space-y-10 p-7 sm:p-10">
          <!-- Last Updated -->
          <div class="border-l-4 border-brand-secondary bg-brand-primary-soft/30 p-4">
            <p class="font-sans text-sm font-semibold text-brand-accent/70">
              Last Updated: <span class="text-brand-secondary">{lastUpdatedDate}</span>
            </p>
          </div>

          <!-- Introduction -->
          <p class="font-sans text-sm leading-relaxed text-brand-accent/70">
            {contactInfo.businessNameLegal} ("{contactInfo.businessName}," "we," "us," or "our")
            operates this website (the "Site"). This Privacy Policy explains what information we
            collect, how we use it, and the choices you may have.
          </p>

          <!-- Information We Collect -->
          <div>
            <h2 class="font-serif text-2xl font-bold text-brand-accent">Information We Collect</h2>

            <div class="mt-4 space-y-6">
              <div>
                <h3 class="font-sans text-base font-semibold text-brand-accent">
                  1) Information You Provide via Contact Form
                </h3>
                <p class="mt-2 font-sans text-sm leading-relaxed text-brand-accent/70">
                  We offer separate forms for employers looking to hire and candidates looking for
                  opportunities. When you submit one of our forms, we may collect information you
                  choose to provide, such as:
                </p>
                <p class="mt-3 font-sans text-sm font-semibold text-brand-accent">For Employers:</p>
                <ul class="mt-2 ml-4 list-disc space-y-1 font-sans text-sm text-brand-accent/70">
                  <li>Full name</li>
                  <li>Company name</li>
                  <li>Work email address</li>
                  <li>Phone number</li>
                  <li>Role(s) needed</li>
                  <li>Hiring timeline</li>
                  <li>Project/search details, including headcount and role requirements</li>
                </ul>
                <p class="mt-3 font-sans text-sm font-semibold text-brand-accent">
                  For Candidates:
                </p>
                <ul class="mt-2 ml-4 list-disc space-y-1 font-sans text-sm text-brand-accent/70">
                  <li>Full name</li>
                  <li>Email address</li>
                  <li>Phone number</li>
                  <li>Target role/specialty</li>
                  <li>LinkedIn profile URL (if provided)</li>
                  <li>Resume (if uploaded)</li>
                  <li>
                    Message content and career preferences, including desired location and
                    compensation
                  </li>
                </ul>
                <div class="mt-4 border border-brand-primary/20 bg-brand-primary-soft/30 p-4">
                  <p class="font-sans text-sm text-brand-accent/70">
                    <span class="font-semibold text-brand-accent">Note:</span> We use Basin to process
                    form submissions, including any resume file you upload. When you submit a form, your
                    information is collected and stored by Basin on our behalf. Basin's privacy practices
                    are governed by their privacy policy, which you can review at
                    <a
                      href="https://usebasin.com/privacy/"
                      class="font-semibold text-brand-secondary underline decoration-brand-secondary/30 underline-offset-4 hover:text-brand-primary-dark"
                      target="_blank"
                      rel="noopener noreferrer">usebasin.com/privacy</a
                    >.
                  </p>
                </div>
              </div>

              <div>
                <h3 class="font-sans text-base font-semibold text-brand-accent">
                  2) Analytics Information
                </h3>
                <p class="mt-2 font-sans text-sm leading-relaxed text-brand-accent/70">
                  We use website analytics to understand how visitors use our Site. Depending on the
                  analytics tool we use, analytics may collect information such as:
                </p>
                <ul class="mt-3 ml-4 list-disc space-y-1 font-sans text-sm text-brand-accent/70">
                  <li>Pages viewed, time on page, and referring/exit pages</li>
                  <li>Approximate location (e.g., city/region) derived from IP address</li>
                  <li>
                    Device/browser information (e.g., browser type, operating system, screen size)
                  </li>
                  <li>General usage events (e.g., clicks or navigation patterns)</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- How We Use Information -->
          <div>
            <h2 class="font-serif text-2xl font-bold text-brand-accent">How We Use Information</h2>
            <p class="mt-4 font-sans text-sm leading-relaxed text-brand-accent/70">
              We use collected information to:
            </p>
            <ul class="mt-3 ml-4 list-disc space-y-1 font-sans text-sm text-brand-accent/70">
              <li>Respond to inquiries and communicate with you</li>
              <li>Provide and improve our Site and services</li>
              <li>Monitor Site performance, troubleshoot issues, and maintain security</li>
              <li>Understand aggregated usage trends to improve content and user experience</li>
            </ul>
          </div>

          <!-- Cookies and Tracking -->
          <div>
            <h2 class="font-serif text-2xl font-bold text-brand-accent">
              Cookies and Tracking Technologies
            </h2>
            <p class="mt-4 font-sans text-sm leading-relaxed text-brand-accent/70">
              We do not intentionally use cookies for our own purposes and we do not operate a
              custom backend database for storing visitor profiles. However, our analytics provider
              may use cookies or similar technologies depending on the tool and configuration. If
              our analytics tool uses cookies, you can usually control them through your browser
              settings and/or any cookie controls we provide on the Site (if applicable).
            </p>
          </div>

          <!-- How We Share Information -->
          <div>
            <h2 class="font-serif text-2xl font-bold text-brand-accent">
              How We Share Information
            </h2>
            <p class="mt-4 font-sans text-sm leading-relaxed text-brand-accent/70">
              We do not sell your personal information. We may share information in limited
              circumstances:
            </p>
            <div class="mt-4 space-y-4">
              <div>
                <h4 class="font-sans text-sm font-semibold text-brand-accent">
                  Service Providers:
                </h4>
                <p class="mt-1 font-sans text-sm leading-relaxed text-brand-accent/70">
                  We may use third-party providers (for example, analytics, Cloudflare for website
                  hosting, spam prevention, or email services) that process information on our
                  behalf to operate the Site and respond to inquiries.
                </p>
              </div>
              <div>
                <h4 class="font-sans text-sm font-semibold text-brand-accent">Legal and Safety:</h4>
                <p class="mt-1 font-sans text-sm leading-relaxed text-brand-accent/70">
                  If required by law, or to protect our rights, safety, and property, or the rights,
                  safety, and property of others.
                </p>
              </div>
              <div>
                <h4 class="font-sans text-sm font-semibold text-brand-accent">
                  Business Transfers:
                </h4>
                <p class="mt-1 font-sans text-sm leading-relaxed text-brand-accent/70">
                  If we undergo a merger, acquisition, or sale of assets, information may be
                  transferred as part of that transaction.
                </p>
              </div>
            </div>
          </div>

          <!-- Data Retention -->
          <div>
            <h2 class="font-serif text-2xl font-bold text-brand-accent">Data Retention</h2>
            <p class="mt-4 font-sans text-sm leading-relaxed text-brand-accent/70">
              Contact form submissions are retained only as long as needed to respond to you,
              maintain records related to our communications, or meet legal or business obligations.
              Analytics data is retained according to the settings and retention policies of our
              analytics provider.
            </p>
          </div>

          <!-- Security -->
          <div>
            <h2 class="font-serif text-2xl font-bold text-brand-accent">Security</h2>
            <p class="mt-4 font-sans text-sm leading-relaxed text-brand-accent/70">
              We use reasonable administrative and technical measures designed to protect
              information. No method of transmission or storage is 100% secure, so we cannot
              guarantee absolute security.
            </p>
          </div>

          <!-- Your Choices -->
          <div>
            <h2 class="font-serif text-2xl font-bold text-brand-accent">Your Choices</h2>
            <p class="mt-4 font-sans text-sm leading-relaxed text-brand-accent/70">
              Depending on your location and applicable law, you may have rights such as:
            </p>
            <ul class="mt-3 ml-4 list-disc space-y-1 font-sans text-sm text-brand-accent/70">
              <li>Requesting access to or deletion of personal information you provided</li>
              <li>Requesting correction of inaccurate personal information</li>
              <li>
                Opting out of certain analytics tracking (when supported), or blocking cookies in
                your browser
              </li>
            </ul>
            <p class="mt-3 font-sans text-sm leading-relaxed text-brand-accent/70">
              To make a request, contact us using the details below.
            </p>
          </div>

          <!-- Children's Privacy -->
          <div>
            <h2 class="font-serif text-2xl font-bold text-brand-accent">Children's Privacy</h2>
            <p class="mt-4 font-sans text-sm leading-relaxed text-brand-accent/70">
              Our Site is not directed to children under 13, and we do not knowingly collect
              personal information from children.
            </p>
          </div>

          <!-- Third-Party Links -->
          <div>
            <h2 class="font-serif text-2xl font-bold text-brand-accent">
              Third-Party Links &amp; External Tools
            </h2>
            <p class="mt-4 font-sans text-sm leading-relaxed text-brand-accent/70">
              Our Site contains links to external third-party websites and services (such as online
              scheduling portals or application systems). We do not control or maintain these
              external sites. Once you click an outbound link to leave our Site, your browsing,
              transactions, and any personal information you provide are governed strictly by the
              privacy policy and terms of that third-party service, not {contactInfo.businessName}.
            </p>
          </div>

          <!-- Changes to This Policy -->
          <div>
            <h2 class="font-serif text-2xl font-bold text-brand-accent">Changes to This Policy</h2>
            <p class="mt-4 font-sans text-sm leading-relaxed text-brand-accent/70">
              We may update this Privacy Policy from time to time. We will post the updated version
              on this page and revise the "Last Updated" date above.
            </p>
          </div>

          <!-- Contact Us -->
          <div class="border border-brand-accent/10 bg-brand-primary-soft/20 p-6">
            <h2 class="font-serif text-2xl font-bold text-brand-accent">Contact Us</h2>
            <div class="mt-3 space-y-1 font-sans text-sm text-brand-accent/70">
              <p class="font-semibold text-brand-accent">{contactInfo.businessNameLegal}</p>
              <p>
                Email:
                <a
                  href={`mailto:${contactInfo.email}`}
                  class="font-semibold text-brand-secondary underline decoration-brand-secondary/30 underline-offset-4 hover:text-brand-primary-dark"
                  >{contactInfo.email}</a
                >
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
