              </span>

              <span class="mt-1 block font-serif text-sm font-bold leading-tight">
                {service.shortName}
              </span>
            </a>
          ))}

        </div>


        {[
          {
            label: 'Leadership-level hire',
            values: ['yes', 'yes', '', '', '', ''],
          },
          {
            label: 'Permanent placement',
            values: ['yes', 'yes', '', '', '', ''],
          },
          {
            label: 'Temporary / project talent',
            values: ['', '', 'yes', '', 'yes', ''],
          },
          {
            label: 'High-volume hiring',
            values: ['', '', '', 'yes', 'yes', ''],
          },
          {
            label: 'New facility / expansion',
            values: ['', '', '', '', 'yes', ''],
          },
          {
            label: 'Embedded recruiting team',
            values: ['', '', '', 'yes', '', ''],
          },
          {
            label: 'Extra recruiting capacity',
            values: ['', '', '', 'yes', '', 'yes'],
          },
          {
            label: 'Hourly engagement',
            values: ['', '', 'yes', '', '', 'yes'],
          },
          {
            label: 'Passive candidate search',
            values: ['yes', 'yes', '', 'yes', 'yes', ''],
          },
        ].map((row, rowIndex) => (
          <div
            class={`grid grid-cols-7 border-t border-brand-accent/10 ${
              rowIndex % 2 === 0 ? 'bg-brand-primary-soft/15' : 'bg-white'
