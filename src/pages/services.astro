---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';

const engagementModels = [
  {
    slug: 'executive-recruitment',
    category: 'Permanent Placement',
    name: 'Executive Recruitment / Retained Search',
    shortName: 'Retained Search',
    tagline: 'Confidential, dedicated search for leadership-level hiring.',
    needStatement: 'Fill a confidential leadership role',
    whatItIs:
      'An exclusive search partnership for executive and leadership-level roles with dedicated recruiting resources, a customized strategy, and access to passive candidates. 98% search success rate, white-glove and confidential from first call to start date.',
    bestFor: [
      'C-suite, VP, and director-level leadership hires',
      'Confidential replacements where discretion is essential',
      'Roles where the right person is not actively job-hunting',
    ],
    includes: [
      'Dedicated recruiting resources',
      'Customized search strategy',
      'Passive candidate outreach',
      'Candidate vetting and evaluation',
      'Offer and onboarding support',
    ],
    image:
      'https://cdn.magicpatterns.com/patterns/generated-images/6d4a5a34-605a-47f6-8686-998d56a1f7ad.jpg',
    imageAlt: 'Two executives in a private boardroom discussion',
  },
  {
    slug: 'direct-hire',
    category: 'Permanent Placement',
    name: 'Direct Hire Placement',
    shortName: 'Direct Hire',
    tagline: 'Permanent placement, sourced and vetted end to end.',
    needStatement: 'Make a permanent hire for a hard-to-fill role',
    whatItIs:
      'Permanent placement for critical roles where we manage sourcing, screening, and offer acceptance. Fees are a percentage of first-year salary, payable only upon a successful hire.',
    bestFor: [
      'Engineering, quality, EHS, supply chain, HR, and operations roles',
      'Companies replacing a key contributor or adding headcount',
      'Hard-to-fill roles where posting a job has not worked',
    ],
    includes: [
      'Candidate sourcing and outreach',
      'Initial screening and qualification',
      'Technical and experience evaluation',
      'Interview coordination',
      'Offer and acceptance support',
    ],
    image:
      'https://cdn.magicpatterns.com/patterns/generated-images/415753f7-452d-4984-b7aa-980617a5bea6.jpg',
    imageAlt:
      'A hiring manager welcoming a newly placed employee in an industrial office',
  },
  {
    slug: 'contract-staffing',
    category: 'Flexible Workforce',
    name: 'Contract Staffing',
    shortName: 'Contract Staffing',
    tagline: 'Flexible technical talent for project work and coverage gaps.',
    needStatement: 'Cover a project or seasonal gap',
    whatItIs:
      'Experienced professionals on our payroll, ready for project demands, seasonal workloads, or interim leadership needs. Contractors can convert to direct hire while compliance, insurance, and onboarding handled on our end.',
    bestFor: [
      'Launches, shutdowns, capital projects, and seasonal ramps',
      'Leave coverage and interim technical leadership',
      'Teams that want to work with someone before committing',
    ],
    includes: [
      'Recruiting and candidate sourcing',
      'Payroll and employment administration',
      'Compliance and insurance handling',
      'Onboarding support',
      'Flexible project and workforce coverage',
    ],
    image:
      'https://cdn.magicpatterns.com/patterns/generated-images/7fe8f4b2-9c3b-43ff-a757-d57c3614df66.jpg',
    imageAlt:
      'Contract technicians working on a capital project inside a manufacturing plant',
  },
  {
    slug: 'rpo',
    category: 'Scaled Recruiting',
    name: 'Recruitment Process Outsourcing (RPO)',
    shortName: 'RPO',
    tagline: 'Your recruiting team, scaled up without adding headcount.',
    needStatement: 'Scale my hiring without growing my team',
    whatItIs:
      'An embedded recruiting partnership for sustained or high-volume hiring. We run requisitions end to end under your employer brand, so hiring managers see consistent quality without carrying the full recruiting load internally.',
    bestFor: [
      'Sustained hiring volume that has outgrown your internal team capacity',
      'Organizations that want recruiting handled under their own employer brand',
      'Companies scaling headcount quickly across multiple roles or sites',
    ],
    includes: [
      'Embedded recruiting support',
      'Requisition management',
      'Sourcing and candidate outreach',
      'Candidate screening and coordination',
      'Scalable recruiting capacity',
    ],
    image:
      'https://cdn.magicpatterns.com/patterns/generated-images/135de5e8-f67b-4978-bc03-f88fe5091c1f.jpg',
    imageAlt:
      'A consultant leading a hiring process working session with an operations team',
  },
  {
    slug: 'greenfield-brownfield',
    category: 'Project Recruiting',
    name: 'Greenfield & Brownfield Recruitment',
    shortName: 'Project Recruiting',
    tagline: 'Project-based recruiting for facility launches and expansions.',
    needStatement: 'Staff a new facility or expansion',
    whatItIs:
      'Project-based recruiting for facility startups, plant expansions, acquisitions, and large-scale workforce growth that is built to hit aggressive, fixed hiring timelines from first hire to full staffing.',
    bestFor: [
      'New facility launches and plant startups',
      'Acquisitions and large-scale workforce growth initiatives',
      'Expansions with aggressive, fixed hiring timelines',
    ],
    includes: [
      'Project-specific recruiting strategy',
      'High-volume candidate sourcing',
      'Workforce planning support',
      'Coordinated hiring execution',
      'Recruiting against fixed project timelines',
    ],
    image:
      'https://images.unsplash.com/photo-1786744026718-a349e80a9533?q=80&w=1548&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
    imageAlt:
      'A guy cutting and measuring wooden planks in a new manufacturing facility under construction',
  },
  {
    slug: 'recruiter-for-hire',
    category: 'Flexible Recruiting',
    name: 'Recruiter for Hire',
    shortName: 'Recruiter for Hire',
    tagline: 'Hourly recruiting support, without a placement-fee commitment.',
    needStatement: 'Add recruiting capacity, hourly',
    whatItIs:
      'Hourly support for sourcing, screening, interviewing, and hiring assistance with expert recruiting resources without a traditional placement-fee structure. Ideal for targeted or ongoing projects that flex with demand.',
    bestFor: [
      'Internal teams that need extra recruiting hands, not another agency fee',
      'Targeted hiring projects with a defined scope',
      'Ongoing support that flexes up or down with demand',
    ],
    includes: [
      'Dedicated recruiting support',
      'Candidate sourcing',
      'Candidate screening',
      'Interview and hiring assistance',
      'Flexible recruiting capacity',
    ],
    image:
      'https://images.unsplash.com/photo-1568992687947-868a62a9f521?q=80&w=1932&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
    imageAlt:
      'Recruiter reviewing resumes and conducting interviews in a modern office environment',
  },
];

const processSteps = [
  {
    number: '01',
    title: 'PARTNERSHIP & ALIGNMENT',
    body: 'We dive deep into your operational environment, culture, and technical requirements to define the exact candidate profile.',
  },
  {
    number: '02',
    title: 'TARGETED SOURCING',
    body: 'Proactive outreach to passive industry talent and vetted networks, going far beyond surface-level job boards.',
  },
  {
    number: '03',
    title: 'VETTING & EVALUATION',
    body: 'Rigorously screened for technical competence, track record, and cultural add before any profile hits your desk.',
  },
  {
    number: '04',
    title: 'OFFER & ONBOARDING',
    body: 'Managing interview cadence, offer negotiations, and resignation transitions through a successful day one.',
  },
];

const comparisonRows = [
  { label: 'Leadership-level hire', values: ['yes', 'yes', '', '', '', ''] },
  { label: 'Permanent placement', values: ['yes', 'yes', '', '', '', ''] },
  { label: 'Temporary / project talent', values: ['', '', 'yes', '', 'yes', ''] },
  { label: 'High-volume hiring', values: ['', '', '', 'yes', 'yes', ''] },
  { label: 'New facility / expansion', values: ['', '', '', '', 'yes', ''] },
  { label: 'Embedded recruiting team', values: ['', '', '', 'yes', '', ''] },
  { label: 'Extra recruiting capacity', values: ['', '', '', 'yes', '', 'yes'] },
  { label: 'Hourly engagement', values: ['', '', 'yes', '', '', 'yes'] },
  { label: 'Passive candidate search', values: ['yes', 'yes', '', 'yes', 'yes', ''] },
];

const pageTitle = 'Services';
const metaDescription =
  'Explore Beacon Search Group engagement models for executive search, direct hire, contract staffing, RPO, project recruiting, and recruiter-for-hire support.';
---

<Layout title={pageTitle} description={metaDescription}>
<PageHero
  eyebrow="Our Services"
  title="Flexible Hiring Solutions"
  intro="From single executive searches to full plant staffing, we tailor our engagement to your needs."
>
  <div class="flex flex-wrap gap-3">
    <a
      href="/contact"
      class="inline-flex items-center gap-2 bg-brand-primary px-6 py-3 font-sans text-sm font-semibold text-white transition hover:bg-brand-primary-dark"
    >
      Talk to Us About Hiring
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>

    <a
      href="/careers"
      class="inline-flex items-center gap-2 border border-white/40 px-6 py-3 font-sans text-sm font-semibold text-white transition hover:border-white hover:bg-white/10"
    >
      I'm looking for a role
    </a>
  </div>
</PageHero>

  <section class="bg-white py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-6">

      <div class="mx-auto max-w-2xl text-center">
        <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-secondary">
          Start Here
        </p>

        <h2 class="mt-2 font-serif text-3xl font-bold tracking-tight text-brand-accent sm:text-4xl">
          Which engagement fits your need?
        </h2>

        <p class="mt-4 font-sans text-base leading-relaxed text-brand-accent/70">
          The right recruiting model depends on what you're trying to accomplish. Start with the hiring problem, and we'll help you choose the right way to engage.
        </p>
      </div>

      <div class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {engagementModels.map((service) => (
          <a
            href={`#${service.slug}`}
            class="group flex min-h-28 items-center gap-4 border border-brand-accent/10 bg-brand-primary-soft/20 p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-primary/30 hover:bg-brand-primary-soft/40"
          >

            <span class="min-w-0 flex-1">
              <span class="block font-sans text-[9px] font-semibold uppercase tracking-[0.15em] text-brand-secondary">
                I need to...
              </span>

              <span class="mt-1 block font-serif text-base font-bold leading-snug text-brand-accent">
                {service.needStatement}
              </span>

              <span class="mt-2 inline-flex items-center gap-1.5 font-sans text-[10px] font-bold uppercase tracking-wider text-brand-primary">
                {service.shortName}
                <svg class="h-3 w-3 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </span>
            </span>
          </a>
        ))}
      </div>

    </div>
  </section>

  
  <section class="bg-brand-primary-soft/30 py-10">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mt-16 space-y-16 sm:space-y-24">
        {engagementModels.map((service, index) => (
          <article
            id={service.slug}
            class="scroll-mt-24"
          >

            <!-- Service Header -->
            <div class="grid gap-8 lg:grid-cols-12 lg:items-end">

              <div class="lg:col-span-8">
                <div class="flex items-center gap-3">
                  <span class="h-px w-12 bg-brand-primary/30"></span>

                  <span class="font-sans text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-secondary">
                    {service.category}
                  </span>
                </div>

                <h3 class="mt-4 font-serif text-3xl font-bold tracking-tight text-brand-accent sm:text-4xl">
                  {service.name}
                </h3>

                <p class="mt-3 max-w-2xl font-serif text-lg italic leading-relaxed text-brand-primary">
                  {service.tagline}
                </p>
              </div>

              <div class="lg:col-span-4 lg:text-right">
                <a
                  href="/contact"
                  class="inline-flex items-center gap-2 border-b border-brand-primary/30 pb-1 font-sans text-xs font-bold uppercase tracking-wider text-brand-primary transition hover:border-brand-primary hover:text-brand-primary-dark"
                >
                  Talk to us about this model
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                  </svg>
                </a>
              </div>

            </div>


            <!-- Main Service Content -->
            <div class="mt-8 grid overflow-hidden border border-brand-accent/10 bg-white lg:grid-cols-12">

              <!-- Image -->
              <div class="relative min-h-72 overflow-hidden lg:col-span-5">
                <img
                  src={service.image}
                  alt={service.imageAlt}
                  class="h-full w-full object-cover"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />

                <div class="absolute inset-0 bg-linear-to-t from-brand-accent/60 via-transparent to-transparent"></div>
              </div>


              <!-- Information -->
              <div class="lg:col-span-7">

                <!-- What It Is -->
                <div class="border-b border-brand-accent/10 p-6 sm:p-8">
                  <p class="max-w-2xl font-sans text-sm leading-relaxed text-brand-accent/75 sm:text-base">
                    {service.whatItIs}
                  </p>
                </div>

                <!-- What You Get -->
                <div class="grid sm:grid-cols-2">

                  <div class="border-b border-brand-accent/10 p-6 sm:border-b-0 sm:border-r sm:p-8">
                    <p class="font-sans text-[9px] font-semibold uppercase tracking-[0.18em] text-brand-accent/45">
                      What You Get
                    </p>

                    <ul class="mt-4 space-y-3">
                      {service.includes.map((item) => (
                        <li class="flex items-start gap-2.5 font-sans text-xs leading-relaxed text-brand-accent/75">
                          <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-brand-primary-soft text-brand-primary">
                            <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                            </svg>
                          </span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>


                  <!-- Best For -->
                  <div class="p-6 sm:p-8">
                    <p class="font-sans text-[9px] font-semibold uppercase tracking-[0.18em] text-brand-accent/45">
                      Best For
                    </p>

                    <ul class="mt-4 space-y-3">
                      {service.bestFor.map((item) => (
                        <li class="font-sans text-xs leading-relaxed text-brand-accent/75">
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>

                </div>
              </div>
            </div>
          </article>
        ))}

      </div>
    </div>
  </section>


  <section class="bg-brand-accent py-20 text-white sm:py-24">
    <div class="mx-auto max-w-6xl px-6">
    
    {/* HEADER */}
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-accent">
        The Beacon Approach
      </p>
      <h2 class="mt-2 font-serif text-3xl font-bold tracking-tight text-white sm:text-4xl">
        One standard of work, regardless of engagement.
      </h2>
      <p class="mt-4 font-sans text-base leading-relaxed text-white/70 sm:text-lg">
        The way you engage us may change. The way we work doesn't. Every search starts with understanding the business, reaches beyond active applicants, and stays focused on the right fit through the finish line.
      </p>
    </div>

    {/* DESKTOP GRID */}
    <div class="hidden grid-cols-4 lg:grid">
      {processSteps.map((s, i) => (
          <div class="flex flex-col items-center text-center">
            {/* Step Number Circle (Brand Secondary / #f59242) */}
            <div class="relative z-10 flex h-10 w-10 items-center justify-center rounded-full bg-brand-secondary text-white shadow-md">
              <span class="font-sans text-sm font-bold tracking-wide">
                {s.number}
              </span>
            </div>

            {/* Connecting Horizontal Line & Dot Node (Brand Primary / #50abe4) */}
            <div class="relative mt-3 flex h-4 w-full items-center justify-center">
              <div
                class={`absolute top-1/2 h-px -translate-y-1/2 bg-white/20 ${i === 0 ? "left-1/2" : "left-0"} right-1/2`}
              />
              <div
                class={`absolute top-1/2 h-px -translate-y-1/2 bg-white/20 left-1/2 ${i === processSteps.length - 1 ? "right-1/2" : "right-0"}`}
              />
              <div class="relative z-10 h-2.5 w-2.5 rounded-full bg-brand-primary shadow-[0_0_8px_rgba(80,171,228,0.8)]" />
            </div>

            {/* Content */}
            <div class="mt-5 px-3">
              <h3 class="font-sans text-base font-bold uppercase tracking-wider text-white">
                {s.title}
              </h3>
              <p class="mx-auto mt-2 max-w-50 font-sans text-sm leading-relaxed text-pretty text-white/65">
                {s.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    {/* MOBILE TIMELINE */}
    <div class="relative lg:hidden">
      {/* Vertical Connecting Line */}
      <div
        class="absolute z-0 w-[1.5px] bg-white/20"
        style="left: 1.2rem; top: 2.6rem; bottom: 2.6rem;"
      >
      </div>
      {processSteps.map((s, i) => (
          <div class="relative flex items-start gap-4 py-6">
            {/* Step Circle */}
            <div class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-secondary text-white shadow-md">
              <span class="font-sans text-sm font-bold tracking-wide">
                {s.number}
              </span>
            </div>

            {/* Dot Node */}
            <div class="mt-[1.1rem] flex shrink-0 items-center self-start">
              <div class="relative z-10 h-2.5 w-2.5 rounded-full bg-brand-primary shadow-[0_0_8px_rgba(80,171,228,0.8)]" />
            </div>

            {/* Content */}
            <div class="pt-1">
              <h3 class="font-sans text-base font-bold uppercase tracking-wider text-white">
                {s.title}
              </h3>
              <p class="mt-1 font-sans text-sm leading-relaxed text-pretty text-white/65">
                {s.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  {/* BOTTOM CTA BUTTON */}
  <div class="mx-auto max-w-3xl pt-12 text-center">
    <Button href="/contact/" variant="primary" size="lg">
      Book a Discovery Meeting now!
      <svg
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </Button>
  </div>
</section>

      <section class="hidden bg-white py-20 sm:py-24 md:block lg:block">
    <div class="mx-auto max-w-6xl px-6">

      <div class="mx-auto max-w-2xl text-center">
        <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-secondary">
          Compare Your Options
        </p>

        <h2 class="mt-2 font-serif text-3xl font-bold tracking-tight text-brand-accent sm:text-4xl">
          Find the right engagement.
        </h2>

        <p class="mt-4 font-sans text-base leading-relaxed text-brand-accent/70">
          Different hiring problems call for different recruiting models. Here's a quick way to see where each engagement fits.
        </p>
      </div>

      <!-- Comparison Table -->
      <div class="mt-12 overflow-hidden border border-brand-accent/10">

        <div class="grid grid-cols-7 bg-brand-accent text-white">
          <div class="p-4">
            <span class="font-sans text-[9px] font-bold uppercase tracking-wider text-white/50">
              Hiring Need
            </span>
          </div>

          {engagementModels.map((service) => (
            <a
              href={`#${service.slug}`}
              class="border-l border-white/10 p-4 transition hover:bg-white/5"
            >
              <span class="mt-1 block font-serif text-sm font-bold leading-tight">
                {service.shortName}
              </span>
            </a>
          ))}
        </div>

        {comparisonRows.map((row, rowIndex) => (
          <div
            class={`grid grid-cols-7 border-t border-brand-accent/10 ${
              rowIndex % 2 === 0 ? 'bg-brand-primary-soft/15' : 'bg-white'
            }`}
          >
            <div class="p-4">
              <span class="font-sans text-xs font-semibold text-brand-accent/75">
                {row.label}
              </span>
            </div>

            {row.values.map((value) => (
              <div class="flex items-center justify-center border-l border-brand-accent/10 p-4">
                {value === 'yes' && (
                  <span class="flex h-5 w-5 items-center justify-center rounded-full bg-brand-primary-soft text-brand-primary">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </span>
                )}
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Layout>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('opacity-0');
        entry.target.classList.add('animate-fade-up'); // or your CSS reveal class
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal-up').forEach((el) => observer.observe(el));
</script>