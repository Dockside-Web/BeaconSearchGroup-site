        </h2>

        <p class="mt-4 text-base leading-relaxed text-white/70 sm:text-lg">
          The way you engage us may change. The way we work doesn't. Every search starts with understanding the business, reaches beyond active applicants, and stays focused on the right fit through the finish line.
        </p>
      </div>


      <div class="relative mt-14">

        <!-- Connecting line -->
        <div class="absolute left-0 right-0 top-9 hidden h-px bg-white/15 lg:block"></div>

        <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {processSteps.map((step) => (
            <li class="relative flex flex-col items-center text-center">

              <div class="relative z-10 mb-5 flex h-18 w-18 items-center justify-center rounded-full bg-brand-primary text-white shadow-lg [&>svg]:h-8 [&>svg]:w-8">
                <Fragment set:html={step.icon} />

                <span class="absolute -right-1 -top-1 flex h-6 w-6 items-center justify-center rounded-full bg-brand-secondary font-sans text-xs font-bold text-brand-accent">
                  {step.number}
                </span>
              </div>

              <h3 class="font-sans text-sm font-bold uppercase tracking-wider text-white">
                {step.title}
              </h3>

              <p class="mt-2 max-w-xs text-sm leading-relaxed text-white/60">
                {step.body}
              </p>

            </li>
          ))}
        </ol>

      </div>
    </div>
  </section>


  <!-- =========================================================
       4. COMPARE ENGAGEMENT MODELS
       ========================================================= -->
  <section class="bg-white py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-6">

