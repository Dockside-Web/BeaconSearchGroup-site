---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import PageHero from '../components/PageHero.astro';

const engagementModels = [
  {
    number: '01',
    slug: 'executive-recruitment',
    category: 'Permanent Placement',
    name: 'Executive Recruitment / Retained Search',
    shortName: 'Retained Search',
    tagline: 'Confidential, dedicated search for leadership-level hiring.',
    whatItIs:
      'An exclusive search partnership for executive and leadership-level roles — dedicated recruiting resources, a customized strategy, and access to passive candidates. 98% search success rate, white-glove and confidential from first call to start date.',
    bestFor: [
      'C-suite, VP, and director-level leadership hires',
      'Confidential replacements where discretion is essential',
      'Roles where the right person is not actively job-hunting',
    ],
    includes: [
      'Dedicated recruiting resources',
      'Customized search strategy',
      'Passive candidate outreach',
      'Candidate vetting and evaluation',
      'Offer and onboarding support',
    ],
    engagement: 'Retained',
    billing: 'Structured search milestones',
    process: [
      {
        number: '01',
        title: 'Align',
        body: 'Define the role, culture, compensation, and candidate profile.'
      },
      {
        number: '02',
        title: 'Map',
        body: 'Identify the target market and reach qualified passive candidates.'
      },
      {
        number: '03',
        title: 'Evaluate',
        body: 'Screen candidates against the technical and leadership requirements.'
      },
      {
        number: '04',
        title: 'Close',
        body: 'Manage interviews, offer negotiations, and the transition to day one.'
      },
    ],
    image:
      'https://cdn.magicpatterns.com/patterns/generated-images/6d4a5a34-605a-47f6-8686-998d56a1f7ad.jpg',
    imageAlt: 'Two executives in a private boardroom discussion',
  },
  {
    number: '02',
    slug: 'direct-hire',
    category: 'Permanent Placement',
    name: 'Direct Hire Placement',
    shortName: 'Direct Hire',
    tagline: 'Permanent placement, sourced and vetted end to end.',
    whatItIs:
      'Permanent placement for critical roles — we manage sourcing, screening, and offer acceptance. Fees are a percentage of first-year salary, payable only upon a successful hire.',
    bestFor: [
      'Engineering, quality, EHS, supply chain, HR, and operations roles',
      'Companies replacing a key contributor or adding headcount',
      'Hard-to-fill roles where posting a job has not worked',
    ],
    includes: [
      'Candidate sourcing and outreach',
      'Initial screening and qualification',
      'Technical and experience evaluation',
      'Interview coordination',
      'Offer and acceptance support',
    ],
    engagement: 'Contingency',
    billing: 'Percentage of first-year salary upon successful hire',
    process: [
      {
        number: '01',
        title: 'Define',
        body: 'Build a clear understanding of the role, requirements, and ideal candidate.'
      },
      {
        number: '02',
        title: 'Source',
        body: 'Identify and engage qualified candidates through targeted recruiting.'
      },
      {
        number: '03',
        title: 'Vet',
        body: 'Screen candidates before presenting them for consideration.'
      },
      {
        number: '04',
        title: 'Place',
        body: 'Support interviews, offer acceptance, and the transition into the role.'
      },
    ],
    image:
      'https://cdn.magicpatterns.com/patterns/generated-images/415753f7-452d-4984-b7aa-980617a5bea6.jpg',
    imageAlt:
      'A hiring manager welcoming a newly placed employee in an industrial office',
  },
  {
    number: '03',
    slug: 'contract-staffing',
    category: 'Flexible Workforce',
    name: 'Contract Staffing',
    shortName: 'Contract Staffing',
    tagline: 'Flexible technical talent for project work and coverage gaps.',
    whatItIs:
      'Experienced professionals on our payroll, ready for project demands, seasonal workloads, or interim leadership needs. Contractors can convert to direct hire — compliance, insurance, and onboarding handled on our end.',
    bestFor: [
      'Launches, shutdowns, capital projects, and seasonal ramps',
      'Leave coverage and interim technical leadership',
      'Teams that want to work with someone before committing',
    ],
    includes: [
      'Recruiting and candidate sourcing',
      'Payroll and employment administration',
      'Compliance and insurance handling',
      'Onboarding support',
      'Flexible project and workforce coverage',
    ],
    engagement: 'Contract',
    billing: 'Hourly',
    process: [
      {
        number: '01',
        title: 'Scope',
        body: 'Understand the project, timeline, technical requirements, and workforce gap.'
      },
      {
        number: '02',
        title: 'Source',
        body: 'Identify experienced professionals aligned with the assignment.'
      },
      {
        number: '03',
        title: 'Deploy',
        body: 'Handle onboarding, payroll, compliance, and placement.'
      },
      {
        number: '04',
        title: 'Support',
        body: 'Stay involved as project needs change or the assignment develops.'
      },
    ],
    image:
      'https://cdn.magicpatterns.com/patterns/generated-images/7fe8f4b2-9c3b-43ff-a757-d57c3614df66.jpg',
    imageAlt:
      'Contract technicians working on a capital project inside a manufacturing plant',
  },
  {
    number: '04',
    slug: 'rpo',
    category: 'Scaled Recruiting',
    name: 'Recruitment Process Outsourcing (RPO)',
    shortName: 'RPO',
    tagline: 'Your recruiting team, scaled up without adding headcount.',
    whatItIs:
      'An embedded recruiting partnership for sustained or high-volume hiring. We run requisitions end to end under your employer brand, so hiring managers see consistent quality without carrying the full recruiting load internally.',
    bestFor: [
      'Sustained hiring volume that has outgrown your internal team capacity',
      'Organizations that want recruiting handled under their own employer brand',
      'Companies scaling headcount quickly across multiple roles or sites',
    ],
    includes: [
      'Embedded recruiting support',
      'Requisition management',
      'Sourcing and candidate outreach',
      'Candidate screening and coordination',
      'Scalable recruiting capacity',
    ],
    engagement: 'Embedded Partnership',
    billing: 'Structured engagement',
    process: [
      {
        number: '01',
        title: 'Assess',
        body: 'Understand your hiring volume, internal capacity, and recruiting workflow.'
      },
      {
        number: '02',
        title: 'Embed',
        body: 'Integrate recruiting resources into your existing team and employer brand.'
      },
      {
        number: '03',
        title: 'Execute',
        body: 'Run requisitions, sourcing, screening, and candidate coordination end to end.'
      },
      {
        number: '04',
        title: 'Scale',
        body: 'Adjust recruiting capacity as hiring demand changes across your organization.'
      },
    ],
    image:
      'https://cdn.magicpatterns.com/patterns/generated-images/135de5e8-f67b-4978-bc03-f88fe5091c1f.jpg',
    imageAlt:
      'A consultant leading a hiring process working session with an operations team',
  },
  {
    number: '05',
    slug: 'greenfield-brownfield',
    category: 'Project Recruiting',
    name: 'Greenfield & Brownfield Recruitment',
    shortName: 'Project Recruiting',
    tagline: 'Project-based recruiting for facility launches and expansions.',
    whatItIs:
      'Project-based recruiting for facility startups, plant expansions, acquisitions, and large-scale workforce growth — built to hit aggressive, fixed hiring timelines from first hire to full staffing.',
    bestFor: [
      'New facility launches and plant startups',
      'Acquisitions and large-scale workforce growth initiatives',
      'Expansions with aggressive, fixed hiring timelines',
    ],
    includes: [
      'Project-specific recruiting strategy',
      'High-volume candidate sourcing',
      'Workforce planning support',
      'Coordinated hiring execution',
      'Recruiting against fixed project timelines',
    ],
    engagement: 'Project-Based',
    billing: 'Structured project engagement',
    process: [
      {
        number: '01',
        title: 'Plan',
        body: 'Map workforce requirements, hiring phases, roles, and project timelines.'
      },
      {
        number: '02',
        title: 'Build',
        body: 'Create the recruiting pipeline needed to support the project.'
      },
      {
        number: '03',
        title: 'Ramp',
        body: 'Accelerate sourcing and candidate flow as hiring volume increases.'
      },
      {
        number: '04',
        title: 'Staff',
        body: 'Drive hiring toward the workforce target and project completion date.'
      },
    ],
    image:
      'https://cdn.magicpatterns.com/patterns/generated-images/a0dfae42-966e-4e92-8b70-76d85e3be4c2.jpg',
    imageAlt:
      'Warehouse operations team managing inventory in a large distribution facility',
  },
  {
    number: '06',
    slug: 'recruiter-for-hire',
    category: 'Flexible Recruiting',
    name: 'Recruiter for Hire',
    shortName: 'Recruiter for Hire',
    tagline: 'Hourly recruiting support, without a placement-fee commitment.',
    whatItIs:
      'Hourly support for sourcing, screening, interviewing, and hiring assistance — expert recruiting resources without a traditional placement-fee structure. Ideal for targeted or ongoing projects that flex with demand.',
    bestFor: [
      'Internal teams that need extra recruiting hands, not another agency fee',
      'Targeted hiring projects with a defined scope',
      'Ongoing support that flexes up or down with demand',
    ],
    includes: [
      'Dedicated recruiting support',
      'Candidate sourcing',
      'Candidate screening',
      'Interview and hiring assistance',
      'Flexible recruiting capacity',
    ],
    engagement: 'Hourly Support',
    billing: 'Hourly',
    process: [
      {
        number: '01',
        title: 'Scope',
        body: 'Define the roles, workload, recruiting needs, and level of support required.'
      },
      {
        number: '02',
        title: 'Integrate',
        body: 'Work alongside your existing team and hiring process.'
      },
      {
        number: '03',
        title: 'Recruit',
        body: 'Provide sourcing, screening, interviewing, and hiring support.'
      },
      {
        number: '04',
        title: 'Adjust',
        body: 'Flex the level of recruiting support as your needs change.'
      },
    ],
    image:
      'https://cdn.magicpatterns.com/patterns/generated-images/f52c5b3a-ec06-48ab-8167-b0088a13037b.jpg',
    imageAlt:
      'Automated production line inside a modern manufacturing plant',
  },
];

const processSteps = [
  {
    number: '1',
    title: 'PARTNERSHIP & ALIGNMENT',
    body: 'We dive deep into your operational environment, culture, and technical requirements to define the exact candidate profile.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`,
  },
  {
    number: '2',
    title: 'TARGETED SOURCING',
    body: 'Proactive outreach to passive industry talent and vetted networks, going far beyond surface-level job boards.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>`,
  },
  {
    number: '3',
    title: 'VETTING & EVALUATION',
    body: 'Rigorously screened for technical competence, track record, and cultural add before any profile hits your desk.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>`,
  },
  {
    number: '4',
    title: 'OFFER & ONBOARDING',
    body: 'Managing interview cadence, offer negotiations, and resignation transitions through a successful day one.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>`,
  },
];

const faqs = [
  {
    question: 'When should I choose retained search vs. direct hire?',
    answer:
      'Retained Search is designed for executive and leadership-level roles where a dedicated, confidential search strategy is important. Direct Hire is designed for permanent roles where sourcing, screening, and placement are managed on a successful-hire basis.',
  },
  {
    question: 'Can contract employees convert to direct hire?',
    answer:
      'Yes. Contract staffing can provide an opportunity to work with someone before making a longer-term commitment, with conversion to direct hire available.',
  },
  {
    question: 'How does RPO differ from Recruiter for Hire?',
    answer:
      'RPO is an embedded recruiting partnership designed around sustained or high-volume hiring, with recruiting handled under your employer brand. Recruiter for Hire provides hourly recruiting support for targeted or ongoing needs without a traditional placement-fee structure.',
  },
  {
    question: 'Can you staff an entire new facility or major expansion?',
    answer:
      'Yes. Greenfield and Brownfield Recruitment is designed for facility startups, plant expansions, acquisitions, and large-scale workforce growth with aggressive, fixed hiring timelines.',
  },
  {
    question: 'How quickly can you start submitting candidates for our role?',
    answer:
      'Our initial intake call takes 30–45 minutes. For standard direct hire and contract roles, you can expect your first batch of vetted candidates within 3 to 5 business days.',
  },
  {
    question: 'What industries and roles do you specialize in?',
    answer:
      'We focus heavily on technical, industrial, and specialized disciplines across engineering, operations, quality, supply chain, EHS, human resources, and C-suite leadership.',
  },
  {
    question: 'How do fee structures work across your engagement models?',
    answer:
      'Direct hire is contingency-based, Retained Search involves structured milestones, Contract Staffing operates on hourly billing, and Recruiter-for-Hire uses hourly advisory rates.',
  },
  {
    question: 'What happens if a placed candidate does not work out?',
    answer:
      'All permanent placements come backed with our standard replacement guarantee period to ensure complete peace of mind and long-term fit.',
  },
];

const pageTitle = 'Services';
const metaDescription =
  'Explore Beacon Search Group engagement models for executive search, direct hire, contract staffing, RPO, project recruiting, and recruiter-for-hire support.';
---

<Layout title={pageTitle} description={metaDescription}>

  <!-- =========================================================
       HERO
       ========================================================= -->
  <PageHero
    eyebrow="Our Services"
    title="Six engagements. One standard of work."
    intro="Retained search, direct hire, contract staffing, RPO, project-based recruiting, and recruiter-for-hire matched to the problem you actually have, whether that's one executive hire or an entire plant to staff."
    image="https://cdn.magicpatterns.com/patterns/generated-images/f52c5b3a-ec06-48ab-8167-b0088a13037b.jpg"
    imageAlt="Automated production line inside a modern manufacturing plant"
  >
    <div class="flex flex-wrap gap-3">
      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-brand-primary px-6 py-3 font-sans text-sm font-semibold text-white transition hover:bg-brand-primary-dark"
      >
        Talk to Us About Hiring
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>

      <a
        href="/careers"
        class="inline-flex items-center gap-2 border border-white/40 px-6 py-3 font-sans text-sm font-semibold text-white transition hover:border-white hover:bg-white/10"
      >
        I'm looking for a role
      </a>
    </div>
  </PageHero>


  <!-- =========================================================
       1. FIND THE RIGHT ENGAGEMENT
       ========================================================= -->
  <section class="bg-white py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-6">

      <div class="mx-auto max-w-2xl text-center">
        <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-secondary">
          Start Here
        </p>

        <h2 class="mt-2 font-serif text-3xl font-bold tracking-tight text-brand-accent sm:text-4xl">
          Which engagement fits your need?
        </h2>

        <p class="mt-4 font-sans text-base leading-relaxed text-brand-accent/70">
          The right recruiting model depends on what you're trying to accomplish. Start with the hiring problem, and we'll help you choose the right way to engage.
        </p>
      </div>

      <div class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {engagementModels.map((service) => (
          <a
            href={`#${service.slug}`}
            class="group flex min-h-28 items-center gap-4 border border-brand-accent/10 bg-brand-primary-soft/20 p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-primary/30 hover:bg-brand-primary-soft/40"
          >
            <span class="font-serif text-2xl font-bold text-brand-primary/70">
              {service.number}
            </span>

            <span class="min-w-0 flex-1">
              <span class="block font-sans text-[9px] font-semibold uppercase tracking-[0.15em] text-brand-secondary">
                I need to...
              </span>

              <span class="mt-1 block font-serif text-base font-bold leading-snug text-brand-accent">
                {service.bestFor[0]}
              </span>

              <span class="mt-2 inline-flex items-center gap-1.5 font-sans text-[10px] font-bold uppercase tracking-wider text-brand-primary">
                {service.shortName}
                <svg class="h-3 w-3 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </span>
            </span>
          </a>
        ))}
      </div>

    </div>
  </section>


  <!-- =========================================================
       2. ENGAGEMENT MODELS
       ========================================================= -->
  <section class="bg-brand-primary-soft/30 py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-6">

      <div class="mx-auto max-w-2xl text-center">
        <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-secondary">
          How We Engage
        </p>

        <h2 class="mt-2 font-serif text-3xl font-bold tracking-tight text-brand-accent sm:text-4xl">
          Recruiting built around the problem you're solving.
        </h2>

        <p class="mt-4 font-sans text-base leading-relaxed text-brand-accent/70">
          Every engagement is structured differently, but the standard stays the same: understand the need, find the right people, and stay involved through the finish line.
        </p>
      </div>


      <div class="mt-16 space-y-16 sm:space-y-24">

        {engagementModels.map((service, index) => (
          <article
            id={service.slug}
            class="scroll-mt-24"
          >

            <!-- Service Header -->
            <div class="grid gap-8 lg:grid-cols-12 lg:items-end">

              <div class="lg:col-span-8">
                <div class="flex items-center gap-3">
                  <span class="font-serif text-4xl font-bold leading-none text-brand-primary/60 sm:text-5xl">
                    {service.number}
                  </span>

                  <span class="h-px w-12 bg-brand-primary/30"></span>

                  <span class="font-sans text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-secondary">
                    {service.category}
                  </span>
                </div>

                <h3 class="mt-4 font-serif text-3xl font-bold tracking-tight text-brand-accent sm:text-4xl">
                  {service.name}
                </h3>

                <p class="mt-3 max-w-2xl font-serif text-lg italic leading-relaxed text-brand-primary">
                  {service.tagline}
                </p>
              </div>

              <div class="lg:col-span-4 lg:text-right">
                <a
                  href="/contact"
                  class="inline-flex items-center gap-2 border-b border-brand-primary/30 pb-1 font-sans text-xs font-bold uppercase tracking-wider text-brand-primary transition hover:border-brand-primary hover:text-brand-primary-dark"
                >
                  Talk to us about this model
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                  </svg>
                </a>
              </div>

            </div>


            <!-- Main Service Content -->
            <div class="mt-8 grid overflow-hidden border border-brand-accent/10 bg-white lg:grid-cols-12">

              <!-- Image -->
              <div class="relative min-h-72 overflow-hidden lg:col-span-5">
                <img
                  src={service.image}
                  alt={service.imageAlt}
                  class="h-full w-full object-cover"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />

                <div class="absolute inset-0 bg-gradient-to-t from-brand-accent/60 via-transparent to-transparent"></div>

                <span class="absolute bottom-5 left-6 font-serif text-7xl font-bold leading-none text-white/20">
                  {service.number}
                </span>
              </div>


              <!-- Information -->
              <div class="lg:col-span-7">

                <!-- What It Is -->
                <div class="border-b border-brand-accent/10 p-6 sm:p-8">
                  <p class="font-sans text-[9px] font-semibold uppercase tracking-[0.18em] text-brand-accent/45">
                    The Engagement
                  </p>

                  <p class="mt-3 max-w-2xl font-sans text-sm leading-relaxed text-brand-accent/75 sm:text-base">
                    {service.whatItIs}
                  </p>
                </div>


                <!-- What You Get -->
                <div class="grid border-b border-brand-accent/10 sm:grid-cols-2">

                  <div class="border-b border-brand-accent/10 p-6 sm:border-b-0 sm:border-r sm:p-8">
                    <p class="font-sans text-[9px] font-semibold uppercase tracking-[0.18em] text-brand-accent/45">
                      What You Get
                    </p>

                    <ul class="mt-4 space-y-3">
                      {service.includes.map((item) => (
                        <li class="flex items-start gap-2.5 font-sans text-xs leading-relaxed text-brand-accent/75">
                          <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-brand-primary-soft text-brand-primary">
                            <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                            </svg>
                          </span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>


                  <!-- Best For -->
                  <div class="p-6 sm:p-8">
                    <p class="font-sans text-[9px] font-semibold uppercase tracking-[0.18em] text-brand-accent/45">
                      Best For
                    </p>

                    <ul class="mt-4 space-y-3">
                      {service.bestFor.map((item) => (
                        <li class="font-sans text-xs leading-relaxed text-brand-accent/75">
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>

                </div>


                <!-- Engagement Structure -->
                <div class="grid sm:grid-cols-2">

                  <div class="border-b border-brand-accent/10 p-6 sm:border-b-0 sm:border-r sm:p-8">
                    <p class="font-sans text-[9px] font-semibold uppercase tracking-[0.18em] text-brand-accent/45">
                      Engagement
                    </p>

                    <p class="mt-2 font-serif text-base font-bold text-brand-accent">
                      {service.engagement}
                    </p>
                  </div>

                  <div class="p-6 sm:p-8">
                    <p class="font-sans text-[9px] font-semibold uppercase tracking-[0.18em] text-brand-accent/45">
                      Billing Structure
                    </p>

                    <p class="mt-2 font-serif text-base font-bold text-brand-accent">
                      {service.billing}
                    </p>
                  </div>

                </div>

              </div>
            </div>


            <!-- How This Engagement Works -->
            <div class="mt-6 border border-brand-accent/10 bg-white p-6 sm:p-8">

              <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <p class="font-sans text-[9px] font-semibold uppercase tracking-[0.18em] text-brand-secondary">
                    How It Works
                  </p>

                  <h4 class="mt-1 font-serif text-xl font-bold text-brand-accent">
                    From first conversation to successful hire.
                  </h4>
                </div>
              </div>

              <ol class="mt-7 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                {service.process.map((step) => (
                  <li class="relative">
                    <div class="flex items-center gap-3">
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-primary font-sans text-[10px] font-bold text-white">
                        {step.number}
                      </span>

                      <span class="h-px flex-1 bg-brand-accent/10 lg:hidden"></span>
                    </div>

                    <h5 class="mt-3 font-sans text-xs font-bold uppercase tracking-wider text-brand-accent">
                      {step.title}
                    </h5>

                    <p class="mt-2 font-sans text-xs leading-relaxed text-brand-accent/65">
                      {step.body}
                    </p>
                  </li>
                ))}
              </ol>

            </div>

          </article>
        ))}

      </div>
    </div>
  </section>


  <!-- =========================================================
       3. THE BEACON APPROACH
       ========================================================= -->
  <section class="bg-brand-accent py-20 text-white sm:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">

      <div class="mx-auto max-w-2xl text-center">
        <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-secondary">
